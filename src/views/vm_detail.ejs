<div class="flex items-center gap-3 mb-6">
  <a href="/" class="text-slate-400 hover:text-white">&larr; Dashboard</a>
  <h1 class="text-2xl font-bold"><%= vm.name %></h1>
  <%- include('partials/status_badge', { vm }) %>
</div>

<div class="grid grid-cols-1 lg:grid-cols-4 gap-4 mb-6">
  <div class="bg-slate-800/60 border border-slate-700 rounded-xl p-4">
    <div class="text-xs text-slate-500 uppercase tracking-wider mb-3">Info</div>
    <div class="space-y-1.5 text-sm">
      <div class="flex justify-between"><span class="text-slate-400">Agent</span><span><%= vm.agent %></span></div>
      <div class="flex justify-between"><span class="text-slate-400">Password</span><span class="font-mono text-xs"><%= vm.password %></span></div>
      <% if (vm.port) { %><div class="flex justify-between"><span class="text-slate-400">SSH Port</span><span><%= vm.port %></span></div><% } %>
      <div class="flex justify-between"><span class="text-slate-400">Config</span><span class="<%= vm.config_exists ? 'text-emerald-400' : 'text-amber-400' %>"><%= vm.config_exists ? 'Present' : 'Not generated' %></span></div>
    </div>
  </div>

  <div class="lg:col-span-2 bg-slate-800/60 border border-slate-700 rounded-xl p-4">
    <div class="text-xs text-slate-500 uppercase tracking-wider mb-3">Actions</div>
    <div class="flex flex-wrap gap-2">
      <% if (vm.status !== 'running') { %>
      <button hx-post="/vm/<%= vm.name %>/start" hx-target="#vm-card-<%= vm.name %>" hx-swap="outerHTML"
              class="bg-emerald-700 hover:bg-emerald-600 text-white px-3 py-1.5 rounded text-xs font-medium transition-colors">Start</button>
      <% } %>
      <% if (vm.status === 'running') { %>
      <button hx-post="/vm/<%= vm.name %>/stop" hx-target="#vm-card-<%= vm.name %>" hx-swap="outerHTML"
              class="bg-amber-700 hover:bg-amber-600 text-white px-3 py-1.5 rounded text-xs font-medium transition-colors">Stop</button>
      <button hx-post="/vm/<%= vm.name %>/restart" hx-target="#vm-card-<%= vm.name %>" hx-swap="outerHTML"
              class="bg-slate-600 hover:bg-slate-500 text-white px-3 py-1.5 rounded text-xs font-medium transition-colors">Restart</button>
      <% } %>
      <a href="/terminal/<%= vm.name %>" class="bg-slate-700 hover:bg-slate-600 text-slate-200 px-3 py-1.5 rounded text-xs font-medium transition-colors">Terminal</a>
      <a href="/onboard/<%= vm.name %>" class="bg-purple-700 hover:bg-purple-600 text-white px-3 py-1.5 rounded text-xs font-medium transition-colors">Onboard</a>
      <button hx-post="/vm/<%= vm.name %>/reset" hx-confirm="Reset <%= vm.name %>? This will wipe all agent data." hx-target="#action-result"
              class="bg-orange-700 hover:bg-orange-600 text-white px-3 py-1.5 rounded text-xs font-medium transition-colors">Reset</button>
      <button hx-post="/vm/<%= vm.name %>/remove" hx-confirm="Remove <%= vm.name %>? This cannot be undone." hx-target="#action-result"
              class="bg-red-700 hover:bg-red-600 text-white px-3 py-1.5 rounded text-xs font-medium transition-colors">Remove</button>
    </div>
    <div id="action-result" class="mt-2"></div>
  </div>

  <div class="bg-slate-800/60 border border-slate-700 rounded-xl p-4">
    <div class="text-xs text-slate-500 uppercase tracking-wider mb-3">Backup</div>
    <p class="text-xs text-slate-500">Backups are being rebuilt. Native driver backups are coming soon.</p>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-4">
  <div class="bg-slate-800/60 border border-slate-700 rounded-xl p-4">
    <div class="flex items-center justify-between mb-2">
      <div class="text-xs text-slate-500 uppercase tracking-wider">Container Logs (last 50)</div>
      <a href="/vm/<%= vm.name %>/logs" target="_blank" class="text-xs text-cyan-400 hover:text-cyan-300">View raw</a>
    </div>
    <pre class="text-xs text-slate-300 leading-tight overflow-auto max-h-64 bg-slate-900/50 rounded p-2 font-mono"><%= logPreview %></pre>
  </div>

  <div class="bg-slate-800/60 border border-slate-700 rounded-xl p-4">
    <div class="text-xs text-slate-500 uppercase tracking-wider mb-2">meta.env</div>
    <pre class="text-xs text-slate-300 leading-tight overflow-auto max-h-64 bg-slate-900/50 rounded p-2 font-mono"><% const metaKeys = Object.keys(meta); if (metaKeys.length > 0) { for (const k of metaKeys) { %><%= k %>=<%= meta[k] %>
<% } } else { %>(empty)<% } %></pre>
  </div>
</div>

<% if (configContent) { %>
<div class="bg-slate-800/60 border border-slate-700 rounded-xl p-4">
  <div class="text-xs text-slate-500 uppercase tracking-wider mb-2">openclaw.json</div>
  <pre class="text-xs text-slate-300 leading-tight overflow-auto max-h-96 bg-slate-900/50 rounded p-2 font-mono"><%= configContent %></pre>
</div>
<% } %>