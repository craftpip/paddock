<div class="max-w-3xl mx-auto">
  <nav class="flex items-center gap-2 text-sm text-slate-400 mb-6">
    <a href="/" class="hover:text-white transition-colors">Dashboard</a>
    <span>/</span>
    <span class="text-white">New VM</span>
  </nav>

  <h1 class="text-2xl font-bold mb-8">Create Virtual Machine</h1>

  <form method="POST" action="/vm/create" class="space-y-8">

    <section class="bg-slate-800/60 border border-slate-700 rounded-xl p-6">
      <div class="flex items-center gap-2 mb-5">
        <div class="w-8 h-8 rounded-lg bg-cyan-900/50 border border-cyan-800 flex items-center justify-center text-sm text-cyan-400 font-bold">1</div>
        <h2 class="text-base font-semibold text-white">General</h2>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-medium text-slate-400 mb-1.5 uppercase tracking-wider">VM Name</label>
          <div class="flex items-center">
            <span class="bg-slate-700 border border-r-0 border-slate-600 rounded-l-lg px-3 py-2 text-sm text-slate-400">vm-</span>
            <input type="text" name="name" required placeholder="my-agent"
                   class="flex-1 bg-slate-700 border border-slate-600 rounded-r-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 placeholder-slate-500">
          </div>
        </div>
        <div>
          <label class="block text-xs font-medium text-slate-400 mb-1.5 uppercase tracking-wider">Agent Type</label>
          <select name="agent" class="w-full bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500">
            <option value="openclaw">OpenClaw</option>
            <option value="picoclaw">PicoClaw</option>
            <option value="hermes">Hermes</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-medium text-slate-400 mb-1.5 uppercase tracking-wider">Root Password</label>
          <input type="text" name="password" placeholder="Defaults to VM name"
                 class="w-full bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 placeholder-slate-500">
        </div>
      </div>
    </section>

    <section class="bg-slate-800/60 border border-slate-700 rounded-xl p-6">
      <div class="flex items-center gap-2 mb-5">
        <div class="w-8 h-8 rounded-lg bg-emerald-900/50 border border-emerald-800 flex items-center justify-center text-sm text-emerald-400 font-bold">2</div>
        <h2 class="text-base font-semibold text-white">Source</h2>
      </div>
      <div class="space-y-3">
        <label class="flex items-center gap-3 p-3 rounded-lg border border-slate-700 bg-slate-800/40 hover:bg-slate-700/40 cursor-pointer transition-colors has-[:checked]:border-cyan-600 has-[:checked]:bg-cyan-900/20">
          <input type="radio" name="mode" value="fresh" checked class="accent-cyan-500">
          <div>
            <div class="text-sm font-medium text-white">Fresh Installation</div>
            <div class="text-xs text-slate-500 mt-0.5">Start with a clean agent configuration</div>
          </div>
        </label>
        <label class="flex items-center gap-3 p-3 rounded-lg border border-slate-700 bg-slate-800/40 hover:bg-slate-700/40 cursor-pointer transition-colors has-[:checked]:border-cyan-600 has-[:checked]:bg-cyan-900/20">
          <input type="radio" name="mode" value="clone" class="accent-cyan-500">
          <div>
            <div class="text-sm font-medium text-white">Clone Existing</div>
            <div class="text-xs text-slate-500 mt-0.5">Copy configuration from another VM</div>
          </div>
        </label>
        <div id="clone-source-group" class="hidden pl-8">
          <select name="clone_source" class="w-full bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-cyan-500">
            <option value="">Select source VM</option>
            <% for (const v of existing) { %>
            <option value="<%= v.name %>"><%= v.name %> (<%= v.agent %>)</option>
            <% } %>
          </select>
        </div>
      </div>
    </section>

    <section class="bg-slate-800/60 border border-slate-700 rounded-xl p-6">
      <div class="flex items-center gap-2 mb-5">
        <div class="w-8 h-8 rounded-lg bg-amber-900/50 border border-amber-800 flex items-center justify-center text-sm text-amber-400 font-bold">3</div>
        <h2 class="text-base font-semibold text-white">Network</h2>
      </div>
      <div class="space-y-4">
        <label class="flex items-center gap-3 cursor-pointer">
          <input type="checkbox" name="ssh_enabled" value="yes" id="ssh-toggle" class="accent-cyan-500 rounded">
          <span class="text-sm text-slate-300">Enable SSH access</span>
        </label>
        <div id="ssh-port-group" class="hidden pl-7">
          <label class="block text-xs font-medium text-slate-400 mb-1.5 uppercase tracking-wider">Port</label>
          <input type="number" name="port" placeholder="Auto (next available)"
                 class="w-full max-w-xs bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 placeholder-slate-500">
        </div>
      </div>
    </section>

    <button type="submit" class="w-full bg-gradient-to-r from-cyan-600 to-blue-600 hover:from-cyan-500 hover:to-blue-500 text-white font-semibold py-3.5 rounded-xl transition-all duration-200 shadow-lg shadow-cyan-900/30">
      Create VM
    </button>
  </form>
</div>

<script>
document.querySelectorAll('input[name="mode"]').forEach(function(el) {
  el.addEventListener('change', function() {
    document.getElementById('clone-source-group').classList.toggle('hidden', this.value !== 'clone');
  });
});
document.getElementById('ssh-toggle').addEventListener('change', function() {
  document.getElementById('ssh-port-group').classList.toggle('hidden', !this.checked);
});
</script>