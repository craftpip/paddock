<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Paddock — Agent Manager</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/htmx.org@2.0.4"></script>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🤖</text></svg>">
  <link rel="stylesheet" href="/codemirror/codemirror.min.css">
  <style>
    .cm-config.CodeMirror {
      background: #0f172a;
      color: #e2e8f0;
      font-family: 'JetBrains Mono', 'Fira Code', monospace;
      font-size: 12px;
      line-height: 1.6;
      height: 500px;
    }
    .cm-config .CodeMirror-gutters {
      background: #0f172a;
      border-right: 1px solid #1e293b;
    }
    .cm-config .CodeMirror-linenumber { color: #475569; }
    .cm-config .CodeMirror-cursor { border-left: 2px solid #22d3ee; }
    .cm-config .CodeMirror-selected { background: #1e3a5f !important; }
    .cm-config .CodeMirror-activeline-background { background: #1e293b; }
    .cm-config .cm-string { color: #34d399; }
    .cm-config .cm-number { color: #f59e0b; }
    .cm-config .cm-atom { color: #f59e0b; }
    .cm-config .cm-keyword { color: #c084fc; }
    .cm-config .cm-property { color: #7dd3fc; }
    .cm-config .cm-def { color: #93c5fd; }
    .cm-config .cm-meta { color: #64748b; }
    .cm-config .cm-variable { color: #e2e8f0; }
    .cm-config .cm-variable-2 { color: #e2e8f0; }
    .cm-config .CodeMirror-matchingbracket { color: #22d3ee !important; font-weight: bold; }
    #config-editor-wrapper { max-height: 498px; overflow: hidden; }
    .cm-workspace.CodeMirror {
      background: #0f172a;
      color: #e2e8f0;
      font-family: 'JetBrains Mono', 'Fira Code', monospace;
      font-size: 13px;
      line-height: 1.6;
      height: 100%;
      min-height: 300px;
    }
    .cm-workspace .CodeMirror-gutters {
      background: #0f172a;
      border-right: 1px solid #1e293b;
    }
    .cm-workspace .CodeMirror-linenumber { color: #475569; }
    .cm-workspace .CodeMirror-cursor { border-left: 2px solid #22d3ee; }
    .cm-workspace .CodeMirror-selected { background: #1e3a5f !important; }
    .cm-workspace .CodeMirror-activeline-background { background: #1e293b; }
    .cm-workspace .cm-string { color: #34d399; }
    .cm-workspace .cm-number { color: #f59e0b; }
    .cm-workspace .cm-atom { color: #f59e0b; }
    .cm-workspace .cm-keyword { color: #c084fc; }
    .cm-workspace .cm-property { color: #7dd3fc; }
    .cm-workspace .cm-def { color: #93c5fd; }
    .cm-workspace .cm-meta { color: #64748b; }
    .cm-workspace .cm-variable { color: #e2e8f0; }
    .cm-workspace .cm-variable-2 { color: #e2e8f0; }
    .cm-workspace .CodeMirror-matchingbracket { color: #22d3ee !important; font-weight: bold; }
  </style>
  <style>
    .skeleton{background:linear-gradient(90deg,#1e293b 25%,#334155 50%,#1e293b 75%);background-size:200% 100%;animation:shimmer 1.5s infinite;border-radius:0.5rem}
    .agent-card.htmx-request,#models-panel.htmx-request{opacity:0.6;pointer-events:none;position:relative}
    .agent-card.htmx-request::after,#models-panel.htmx-request::after{content:'';position:absolute;inset:0;background:rgba(0,0,0,.15);border-radius:inherit}
    #models-panel.htmx-settling{transition:none}
    @keyframes shimmer{0%{background-position:200% 0}100%{background-position:-200% 0}}

    .toast-enter{animation:toastIn 0.3s ease-out}
    .toast-exit{animation:toastOut 0.3s ease-in forwards}
    @keyframes toastIn{from{opacity:0;transform:translateY(1rem)}to{opacity:1;transform:translateY(0)}}
    @keyframes toastOut{from{opacity:1;transform:translateY(0)}to{opacity:0;transform:translateY(1rem)}}
    @keyframes pulse{0%,100%{opacity:1}50%{opacity:0.4}}
    .animate-pulse{animation:pulse 1.5s ease-in-out infinite}
    .terminal-wrapper .xterm{height:100%;padding:4px}
    .terminal-wrapper .xterm-viewport{background:#0f172a !important}
    .terminal-wrapper .xterm-screen{background:#0f172a}
    .xterm .xterm-viewport::-webkit-scrollbar{width:8px}
    .xterm .xterm-viewport::-webkit-scrollbar-track{background:transparent}
    .xterm .xterm-viewport::-webkit-scrollbar-thumb{background:#334155;border-radius:4px}
    .xterm .xterm-viewport::-webkit-scrollbar-thumb:hover{background:#475569}
  </style>
  <script src="/xterm.js"></script>
  <link rel="stylesheet" href="/xterm.css">
  <script src="/xterm-addon-fit.js"></script>
  <script src="/xterm-addon-web-links.js"></script>
</head>
<body class="bg-slate-900 text-slate-100 font-sans antialiased <%= (typeof fullHeight !== 'undefined' && fullHeight) ? 'h-screen flex flex-col overflow-hidden' : 'min-h-screen' %>">
  <nav class="border-b border-slate-800 bg-slate-900/80 sticky top-0 z-50 backdrop-blur-lg">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="flex items-center justify-between h-14">
        <a href="/agents" class="flex items-center gap-2.5 text-base font-bold tracking-tight text-cyan-400 hover:text-cyan-300 transition-colors">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          Paddock
        </a>
        <div class="flex items-center gap-0.5">
          <a href="/agents" class="px-3 py-1.5 rounded-lg text-sm text-slate-300 hover:text-white hover:bg-slate-800 transition-colors">Agents</a>
          <a href="/agents/create" class="px-3 py-1.5 rounded-lg text-sm text-slate-300 hover:text-white hover:bg-slate-800 transition-colors">+ Agent</a>
          <a href="/credentials" class="px-3 py-1.5 rounded-lg text-sm text-slate-300 hover:text-white hover:bg-slate-800 transition-colors">Creds</a>
          <a href="/backups" class="px-3 py-1.5 rounded-lg text-sm text-slate-300 hover:text-white hover:bg-slate-800 transition-colors">Backups</a>
          <span class="w-px h-5 bg-slate-700 mx-1.5"></span>
          <a href="/logout" class="px-3 py-1.5 rounded-lg text-sm text-slate-500 hover:text-red-400 hover:bg-slate-800 transition-colors" title="Sign out">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
          </a>
        </div>
      </div>
    </div>
  </nav>

  <main class="<%= (typeof fullHeight !== 'undefined' && fullHeight) ? 'flex-1 overflow-hidden flex flex-col' : ((typeof fullWidth !== 'undefined' && fullWidth) ? 'w-full px-4 sm:px-6 lg:px-8 py-6' : 'max-w-7xl mx-auto px-4 sm:px-6 py-8') %>">
    <%- body %>
  </main>

  <div id="toast-container" class="fixed bottom-6 right-6 z-50 space-y-2"></div>

  <div id="modal-overlay" class="fixed inset-0 z-[60] bg-black/50 hidden items-center justify-center" onclick="if(event.target===this)closeModal()">
    <div id="modal-content" class="bg-slate-800 border border-slate-700 rounded-xl p-6 max-w-md mx-4 shadow-2xl"></div>
  </div>

  <script>
  var VMF = {
    toast: function(msg, type) {
      type = type || 'info';
      var colors = { success: 'border-emerald-600 bg-emerald-900/50 text-emerald-200', error: 'border-red-600 bg-red-900/50 text-red-200', info: 'border-cyan-600 bg-cyan-900/50 text-cyan-200', warning: 'border-amber-600 bg-amber-900/50 text-amber-200' };
      var icons = { success: '&#10003;', error: '&#10007;', info: '&#9432;', warning: '&#9888;' };
      var el = document.createElement('div');
      el.className = 'toast-enter border rounded-lg px-4 py-3 text-sm flex items-center gap-2 min-w-[280px] shadow-lg ' + (colors[type] || colors.info);
      el.innerHTML = '<span>' + (icons[type] || icons.info) + '</span><span>' + msg + '</span>';
      document.getElementById('toast-container').appendChild(el);
      setTimeout(function() { el.classList.replace('toast-enter', 'toast-exit'); setTimeout(function() { el.remove(); }, 300); }, 4000);
    },
    confirm: function(opts, onConfirm) {
      var overlay = document.getElementById('modal-overlay');
      var content = document.getElementById('modal-content');
      var danger = opts.danger ? 'bg-red-600 hover:bg-red-500' : 'bg-cyan-600 hover:bg-cyan-500';
      content.innerHTML = '<h3 class="text-lg font-semibold text-white mb-2">' + (opts.title || 'Confirm') + '</h3>' +
        '<p class="text-sm text-slate-400 mb-6">' + (opts.message || 'Are you sure?') + '</p>' +
        '<div class="flex justify-end gap-3">' +
        '<button onclick="VMF.closeModal()" class="px-4 py-2 bg-slate-700 hover:bg-slate-600 text-white rounded-lg text-sm transition-colors">Cancel</button>' +
        '<button id="modal-confirm-btn" class="px-4 py-2 ' + danger + ' text-white rounded-lg text-sm transition-colors">' + (opts.confirmText || 'Confirm') + '</button></div>';
      overlay.classList.remove('hidden');
      overlay.classList.add('flex');
      document.getElementById('modal-confirm-btn').onclick = function() { VMF.closeModal(); onConfirm(); };
    },
    closeModal: function() {
      var overlay = document.getElementById('modal-overlay');
      overlay.classList.add('hidden');
      overlay.classList.remove('flex');
    },
    post: function(url, body) {
      var form = document.createElement('form');
      form.method = 'POST';
      form.action = url;
      if (body) {
        for (var k in body) {
          if (body.hasOwnProperty(k)) {
            var input = document.createElement('input');
            input.type = 'hidden';
            input.name = k;
            input.value = body[k];
            form.appendChild(input);
          }
        }
      }
      document.body.appendChild(form);
      form.submit();
    }
  };
  if (window._flash) { VMF.toast(window._flash.message, window._flash.type); }
  VMF.initTerminal = function(container) {
    var agentName = container.getAttribute('data-agent-name');
    if (!agentName || !window.Terminal) return;
    if (container._termInit) return;
    container._termInit = true;

    var statusDot = document.getElementById('term-status-dot');
    var statusText = document.getElementById('term-status-text');
    var dimEl = document.getElementById('term-dimensions');
    var fontSizeEl = document.getElementById('term-font-size');
    var wrapper = container.closest('#terminal-wrapper');

    function setStatus(color, text) {
      if (statusDot) { statusDot.className = 'w-2 h-2 rounded-full ' + color; }
      if (statusText) statusText.textContent = text;
    }
    setStatus('bg-slate-600', 'Disconnected');

    var fitAddon = new FitAddon.FitAddon();
    var webLinksAddon = new WebLinksAddon.WebLinksAddon();

    var term = new Terminal({
      cursorBlink: true,
      cursorStyle: 'bar',
      fontSize: 14,
      fontFamily: '"Cascadia Code", "Fira Code", "JetBrains Mono", Menlo, monospace',
      fontWeight: '400',
      fontWeightBold: '700',
      scrollback: 10000,
      theme: {
        background: '#0f172a',
        foreground: '#e2e8f0',
        cursor: '#22d3ee',
        cursorAccent: '#0f172a',
        selectionBackground: '#334155',
        selectionForeground: '#f1f5f9',
        black: '#1e293b',
        red: '#f87171',
        green: '#34d399',
        yellow: '#fbbf24',
        blue: '#60a5fa',
        magenta: '#c084fc',
        cyan: '#22d3ee',
        white: '#e2e8f0',
        brightBlack: '#475569',
        brightRed: '#fca5a5',
        brightGreen: '#6ee7b7',
        brightYellow: '#fde68a',
        brightBlue: '#93c5fd',
        brightMagenta: '#d8b4fe',
        brightCyan: '#67e8f9',
        brightWhite: '#f8fafc'
      },
      allowProposedApi: true,
      minimumContrastRatio: 1
    });
    term.loadAddon(fitAddon);
    term.loadAddon(webLinksAddon);
    term.open(container);

    function updateDims() {
      if (dimEl) dimEl.textContent = (term.cols || 80) + 'x' + (term.rows || 24);
    }

    function doFit() {
      try { fitAddon.fit(); } catch(e) {}
      updateDims();
    }

    var protocol = location.protocol === 'https:' ? 'wss:' : 'ws:';
    var ws = null;
    var connected = false;
    var cols = 80, rows = 24;

    function connectWs() {
      var oldWs = ws;
      ws = null;
      if (oldWs) { try { oldWs.onclose = null; oldWs.close(); } catch(e) {} }
      doFit();
      cols = term.cols || 80;
      rows = term.rows || 24;
      setStatus('bg-amber-500 animate-pulse', 'Connecting...');
      var sock = new WebSocket(protocol + '//' + location.host + '/ws/terminal/' + agentName + '?cols=' + cols + '&rows=' + rows);
      sock.onopen = function() {
        ws = sock; connected = true;
        setStatus('bg-emerald-400', 'Connected');
        term.focus();
      };
      sock.onmessage = function(evt) { term.write(evt.data); };
      sock.onclose = function() {
        connected = false;
        if (ws === sock) ws = null;
        setStatus('bg-red-400', 'Disconnected');
        term.write('\r\n\x1b[31m[Connection closed]\x1b[0m\r\n');
      };
      sock.onerror = function() {
        setStatus('bg-red-400', 'Error');
        term.write('\r\n\x1b[31m[Connection error]\x1b[0m\r\n');
      };
    }

    term.onData(function(data) { if (connected && ws) ws.send(data); });
    term.onResize(function(size) {
      if (connected && ws) ws.send(JSON.stringify({ type: 'resize', cols: size.cols, rows: size.rows }));
      updateDims();
    });

    var resizeTimer;
    var onResize = function() {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(function() {
        doFit();
        if (ws && connected) {
          ws.send(JSON.stringify({ type: 'resize', cols: term.cols, rows: term.rows }));
        }
        updateDims();
      }, 100);
    };
    window.addEventListener('resize', onResize);
    new ResizeObserver(onResize).observe(container);

    var visObs = new IntersectionObserver(function(entries) {
      entries.forEach(function(e) {
        if (e.isIntersecting && !connected) {
          connectWs();
          setTimeout(doFit, 50);
        }
      });
    });
    visObs.observe(container);

    // Font size controls
    var fontSize = 14;
    function setFontSize(size) {
      fontSize = Math.max(10, Math.min(24, size));
      term.options.fontSize = fontSize;
      if (fontSizeEl) fontSizeEl.textContent = fontSize;
      setTimeout(doFit, 50);
    }
    var fontInc = document.getElementById('term-font-inc');
    var fontDec = document.getElementById('term-font-dec');
    if (fontInc) fontInc.addEventListener('click', function() { setFontSize(fontSize + 1); });
    if (fontDec) fontDec.addEventListener('click', function() { setFontSize(fontSize - 1); });

    // Clear
    var clearBtn = document.getElementById('term-clear');
    if (clearBtn) clearBtn.addEventListener('click', function() { term.clear(); });

    // Reconnect
    var reconnectBtn = document.getElementById('term-reconnect');
    if (reconnectBtn) reconnectBtn.addEventListener('click', function() {
      if (ws) { try { ws.close(); } catch(e) {} ws = null; }
      connected = false;
      connectWs();
    });
  };


  // Re-execute <script> tags in HTMX-swapped content
  document.addEventListener('htmx:afterSwap', function(evt) {
    // Re-run scripts in the swapped content
    var el = evt.detail.target;
    if (el.nodeType === 1) { // Element node
      var scripts = el.querySelectorAll('script');
      scripts.forEach(function(old) {
        var s = document.createElement('script');
        if (old.src) { s.src = old.src; }
        else { s.textContent = old.textContent; }
        document.body.appendChild(s);
      });
    }
    // Toast cleanup
    if (evt.detail.target.id === 'toast' && document.getElementById('toast').children.length > 0) {
      setTimeout(function() { document.getElementById('toast').innerHTML = ''; }, 5000);
    }
    // Init terminal if present
    var termEl = evt.detail.target.querySelector ? evt.detail.target.querySelector('#terminal-container') : null;
    if (termEl && VMF.initTerminal) VMF.initTerminal(termEl);
  });
  // Re-execute global htmx scripts (non-inline) after swap
  document.addEventListener('htmx:afterSwap', function(evt) {
    var scripts = document.querySelectorAll('script[src]');
    scripts.forEach(function(old) {
      if (!old.dataset.hmxGlobal) {
        old.dataset.hmxGlobal = '1';
        var s = document.createElement('script');
        s.src = old.src;
        s.dataset.hmxGlobal = '1';
        document.body.appendChild(s);
      }
    });
  });

  // Also init terminal on direct page load
  document.addEventListener('DOMContentLoaded', function() {
    var termEl = document.querySelector('#terminal-container');
    if (termEl && VMF.initTerminal) VMF.initTerminal(termEl);
  });

  (function() {
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') VMF.closeModal();
      if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
        e.preventDefault();
        var searchInput = document.getElementById('global-search');
        if (searchInput) searchInput.focus();
      }
    });
  })();
  </script>
  <script src="/codemirror/codemirror.min.js"></script>
  <script src="/codemirror/javascript.min.js"></script>
  <script src="/codemirror/matchbrackets.min.js"></script>
  <script src="/codemirror/closebrackets.min.js"></script>
  <script src="/codemirror/yaml.min.js"></script>
  <script src="/codemirror/js-yaml.min.js"></script>
</body>
</html>
