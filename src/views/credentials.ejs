<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold">Credential Manager</h1>
  <button hx-post="/credentials/import" hx-target="#import-result"
          class="bg-slate-700 hover:bg-slate-600 text-slate-200 px-4 py-2 rounded-lg text-sm">
    Import from bot-prefixes.json
  </button>
</div>
<div id="import-result"></div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
  <%# API Keys %>
  <div class="bg-slate-800/60 border border-slate-700 rounded-xl p-4">
    <div class="text-sm font-semibold text-slate-300 mb-3">API Keys</div>
    <form hx-post="/credentials/api-keys" hx-target="#api-keys-body" hx-swap="beforeend"
          class="space-y-2 mb-3">
      <input type="text" name="name" placeholder="Name" required
             class="w-full bg-slate-700 border border-slate-600 rounded px-2 py-1.5 text-xs text-white placeholder-slate-500">
      <select name="provider" required class="w-full bg-slate-700 border border-slate-600 rounded px-2 py-1.5 text-xs text-white">
        <option value="">Provider</option>
        <option value="openai">OpenAI</option>
        <option value="openrouter">OpenRouter</option>
        <option value="ollama-cloud">Ollama Cloud</option>
        <option value="anthropic">Anthropic</option>
      </select>
      <input type="text" name="key" placeholder="sk-..." required
             class="w-full bg-slate-700 border border-slate-600 rounded px-2 py-1.5 text-xs text-white placeholder-slate-500">
      <button type="submit" class="w-full bg-cyan-700 hover:bg-cyan-600 text-white px-2 py-1.5 rounded text-xs">+ Add Key</button>
    </form>
    <table class="w-full text-xs">
      <thead><tr class="text-slate-500 border-b border-slate-700"><th class="text-left py-1">Name</th><th class="text-left py-1">Provider</th><th class="text-left py-1">Key</th><th></th></tr></thead>
      <tbody id="api-keys-body">
        <% for (const [name, ak] of Object.entries(api_keys)) { %>
        <%- include('partials/api_key_row', { name, ak, mask_key }) %>
        <% } %>
      </tbody>
    </table>
  </div>

  <%# Bot Tokens %>
  <div class="bg-slate-800/60 border border-slate-700 rounded-xl p-4">
    <div class="text-sm font-semibold text-slate-300 mb-3">Bot Tokens</div>
    <form hx-post="/credentials/bot-tokens" hx-target="#bot-tokens-body" hx-swap="beforeend"
          class="space-y-2 mb-3">
      <input type="text" name="name" placeholder="Name" required
             class="w-full bg-slate-700 border border-slate-600 rounded px-2 py-1.5 text-xs text-white placeholder-slate-500">
      <input type="text" name="token" placeholder="123456:ABCdef..." required
             class="w-full bg-slate-700 border border-slate-600 rounded px-2 py-1.5 text-xs text-white placeholder-slate-500">
      <button type="submit" class="w-full bg-cyan-700 hover:bg-cyan-600 text-white px-2 py-1.5 rounded text-xs">+ Add Token</button>
    </form>
    <table class="w-full text-xs">
      <thead><tr class="text-slate-500 border-b border-slate-700"><th class="text-left py-1">Name</th><th class="text-left py-1">Token</th><th></th></tr></thead>
      <tbody id="bot-tokens-body">
        <% for (const [name, token] of Object.entries(bot_tokens)) { %>
        <%- include('partials/bot_token_row', { name, token, mask_key }) %>
        <% } %>
      </tbody>
    </table>
  </div>

  <%# User IDs %>
  <div class="bg-slate-800/60 border border-slate-700 rounded-xl p-4">
    <div class="text-sm font-semibold text-slate-300 mb-3">User IDs</div>
    <form hx-post="/credentials/user-ids" hx-target="#user-ids-body" hx-swap="beforeend"
          class="space-y-2 mb-3">
      <input type="text" name="name" placeholder="Name (e.g. boniface)" required
             class="w-full bg-slate-700 border border-slate-600 rounded px-2 py-1.5 text-xs text-white placeholder-slate-500">
      <input type="text" name="uid" placeholder="532156945" required
             class="w-full bg-slate-700 border border-slate-600 rounded px-2 py-1.5 text-xs text-white placeholder-slate-500">
      <button type="submit" class="w-full bg-cyan-700 hover:bg-cyan-600 text-white px-2 py-1.5 rounded text-xs">+ Add User</button>
    </form>
    <table class="w-full text-xs">
      <thead><tr class="text-slate-500 border-b border-slate-700"><th class="text-left py-1">Name</th><th class="text-left py-1">User ID</th><th></th></tr></thead>
      <tbody id="user-ids-body">
        <% for (const [name, uid] of Object.entries(user_ids)) { %>
        <%- include('partials/user_id_row', { name, uid }) %>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
