<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold tracking-tight">Credentials</h1>
  <div class="flex items-center gap-3">
    <span class="text-xs text-slate-500">Import from</span>
    <button hx-post="/credentials/import" hx-target="#import-result"
            class="bg-slate-700 hover:bg-slate-600 text-slate-200 px-3 py-1.5 rounded-lg text-xs font-medium transition-colors">
      bot-prefixes.json
    </button>
  </div>
</div>
<div id="import-result"></div>

<div class="flex gap-6 flex-1 min-h-0" id="creds-layout">
  <aside class="w-48 flex-shrink-0" id="creds-sidebar">
    <nav class="space-y-1 sticky top-24">
      <button class="sidebar-btn w-full text-left px-3 py-2.5 text-sm font-medium rounded-lg border-l-[3px] border-cyan-400 text-cyan-400 bg-cyan-950/40 transition-all" data-tab="api-keys">
        <span class="flex items-center gap-2.5">
          <svg class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg>
          API Keys
        </span>
      </button>
      <button class="sidebar-btn w-full text-left px-3 py-2.5 text-sm font-medium rounded-lg border-l-[3px] border-transparent text-slate-400 hover:text-slate-200 hover:bg-slate-800/50 transition-all" data-tab="messaging">
        <span class="flex items-center gap-2.5">
          <svg class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
          Messaging
        </span>
      </button>
    </nav>
  </aside>

  <div id="creds-tab-content" class="flex-1 min-w-0">
    <!-- API Keys Tab -->
    <div id="tab-api-keys" class="tab-panel">
      <div class="bg-slate-800/50 border border-slate-700/60 rounded-xl overflow-hidden">
        <div class="px-5 py-4 border-b border-slate-700/60">
          <div class="flex items-center gap-3">
            <h2 class="text-base font-semibold text-slate-100">API Keys</h2>
            <span class="text-[11px] text-slate-500 bg-slate-800 px-2 py-0.5 rounded-full">agent model authentication</span>
          </div>
        </div>
        <div class="p-5">
          <form hx-post="/credentials/api-keys" hx-target="#api-keys-body" hx-swap="beforeend"
                class="grid grid-cols-1 sm:grid-cols-[1fr_auto_1fr_auto] gap-3 mb-5 items-end">
            <div>
              <label class="block text-[11px] font-medium text-slate-500 mb-1">Name</label>
              <input type="text" name="name" placeholder="e.g. my-key" required
                     class="w-full bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-sm text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-cyan-500/40 focus:border-cyan-500 transition-colors">
            </div>
            <div>
              <label class="block text-[11px] font-medium text-slate-500 mb-1">Provider</label>
              <select name="provider" required class="w-full bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:ring-2 focus:ring-cyan-500/40 focus:border-cyan-500 transition-colors">
                <option value="">Select</option>
                <option value="openai">OpenAI</option>
                <option value="openrouter">OpenRouter</option>
                <option value="ollama-cloud">Ollama Cloud</option>
                <option value="anthropic">Anthropic</option>
              </select>
            </div>
            <div>
              <label class="block text-[11px] font-medium text-slate-500 mb-1">Key</label>
              <input type="text" name="key" placeholder="sk-..." required
                     class="w-full bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-sm text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-cyan-500/40 focus:border-cyan-500 transition-colors">
            </div>
            <button type="submit" class="bg-cyan-700 hover:bg-cyan-600 text-white px-4 py-2 rounded-lg text-sm font-medium whitespace-nowrap transition-colors flex items-center gap-1.5">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
              Add Key
            </button>
          </form>
          <table class="w-full text-sm">
            <thead>
              <tr class="text-slate-500 border-b border-slate-700/60">
                <th class="text-left font-medium py-2.5 px-3 w-[22%]">Name</th>
                <th class="text-left font-medium py-2.5 px-3 w-[22%]">Provider</th>
                <th class="text-left font-medium py-2.5 px-3">Key</th>
                <th class="text-right font-medium py-2.5 px-3 w-[80px]"></th>
              </tr>
            </thead>
            <tbody id="api-keys-body" class="divide-y divide-slate-700/40">
              <% for (const [name, ak] of Object.entries(api_keys)) { %>
              <%- include('partials/api_key_row', { name, ak, mask_key }) %>
              <% } %>
              <% if (Object.keys(api_keys).length === 0) { %>
              <tr><td colspan="4" class="py-8 text-center text-sm text-slate-600">No API keys configured</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Messaging Tab -->
    <div id="tab-messaging" class="tab-panel hidden">
      <div class="space-y-6">

        <!-- Bot Tokens -->
        <div class="bg-slate-800/50 border border-slate-700/60 rounded-xl overflow-hidden">
          <div class="px-5 py-4 border-b border-slate-700/60">
            <div class="flex items-center gap-3">
              <h2 class="text-base font-semibold text-slate-100">Bot Tokens</h2>
              <span class="text-[11px] text-slate-500 bg-slate-800 px-2 py-0.5 rounded-full">messaging platform auth</span>
            </div>
          </div>
          <div class="p-5">
            <form hx-post="/credentials/bot-tokens" hx-target="#bot-tokens-body" hx-swap="beforeend"
                  class="grid grid-cols-1 sm:grid-cols-[1fr_1fr_auto] gap-3 mb-5 items-end">
              <div>
                <label class="block text-[11px] font-medium text-slate-500 mb-1">Name</label>
                <input type="text" name="name" placeholder="e.g. my_bot" required
                       class="w-full bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-sm text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-cyan-500/40 focus:border-cyan-500 transition-colors">
              </div>
              <div>
                <label class="block text-[11px] font-medium text-slate-500 mb-1">Token</label>
                <input type="text" name="token" placeholder="123456:ABCdef..." required
                       class="w-full bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-sm text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-cyan-500/40 focus:border-cyan-500 transition-colors">
              </div>
              <button type="submit" class="bg-cyan-700 hover:bg-cyan-600 text-white px-4 py-2 rounded-lg text-sm font-medium whitespace-nowrap transition-colors flex items-center gap-1.5">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
                Add Token
              </button>
            </form>
            <table class="w-full text-sm">
              <thead>
                <tr class="text-slate-500 border-b border-slate-700/60">
                  <th class="text-left font-medium py-2.5 px-3 w-[22%]">Name</th>
                  <th class="text-left font-medium py-2.5 px-3">Token</th>
                  <th class="text-left font-medium py-2.5 px-3 w-[22%]">Platform</th>
                  <th class="text-right font-medium py-2.5 px-3 w-[80px]"></th>
                </tr>
              </thead>
              <tbody id="bot-tokens-body" class="divide-y divide-slate-700/40">
                <% for (const [name, val] of Object.entries(bot_tokens)) { %>
                <% const tokenStr = typeof val === 'string' ? val : val.token; %>
                <% const platform = typeof val === 'string' ? 'telegram' : (val.platform || 'telegram'); %>
                <%- include('partials/bot_token_row', { name, token: tokenStr, platform, mask_key }) %>
                <% } %>
                <% if (Object.keys(bot_tokens).length === 0) { %>
                <tr><td colspan="4" class="py-8 text-center text-sm text-slate-600">No bot tokens configured</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Allowed User IDs -->
        <div class="bg-slate-800/50 border border-slate-700/60 rounded-xl overflow-hidden">
          <div class="px-5 py-4 border-b border-slate-700/60">
            <div class="flex items-center gap-3">
              <h2 class="text-base font-semibold text-slate-100">Allowed User IDs</h2>
              <span class="text-[11px] text-slate-500 bg-slate-800 px-2 py-0.5 rounded-full">allowlisted DM access</span>
            </div>
          </div>
          <div class="p-5">
            <form hx-post="/credentials/user-ids" hx-target="#user-ids-body" hx-swap="beforeend"
                  class="grid grid-cols-1 sm:grid-cols-[1fr_1fr_auto] gap-3 mb-5 items-end">
              <div>
                <label class="block text-[11px] font-medium text-slate-500 mb-1">Name</label>
                <input type="text" name="name" placeholder="e.g. boniface" required
                       class="w-full bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-sm text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-cyan-500/40 focus:border-cyan-500 transition-colors">
              </div>
              <div>
                <label class="block text-[11px] font-medium text-slate-500 mb-1">User ID</label>
                <input type="text" name="uid" placeholder="Telegram user ID" required
                       class="w-full bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-sm text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-cyan-500/40 focus:border-cyan-500 transition-colors">
              </div>
              <button type="submit" class="bg-cyan-700 hover:bg-cyan-600 text-white px-4 py-2 rounded-lg text-sm font-medium whitespace-nowrap transition-colors flex items-center gap-1.5">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
                Add User
              </button>
            </form>
            <table class="w-full text-sm">
              <thead>
                <tr class="text-slate-500 border-b border-slate-700/60">
                  <th class="text-left font-medium py-2.5 px-3 w-[22%]">Name</th>
                  <th class="text-left font-medium py-2.5 px-3">User ID</th>
                  <th class="text-left font-medium py-2.5 px-3 w-[22%]">Platform</th>
                  <th class="text-right font-medium py-2.5 px-3 w-[80px]"></th>
                </tr>
              </thead>
              <tbody id="user-ids-body" class="divide-y divide-slate-700/40">
                <% for (const [name, val] of Object.entries(user_ids)) { %>
                <% const uidStr = typeof val === 'string' ? val : val.uid; %>
                <% const platform = typeof val === 'string' ? 'telegram' : (val.platform || 'telegram'); %>
                <%- include('partials/user_id_row', { name, uid: uidStr, platform }) %>
                <% } %>
                <% if (Object.keys(user_ids).length === 0) { %>
                <tr><td colspan="4" class="py-8 text-center text-sm text-slate-600">No user IDs configured</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>

      </div>
    </div>
  </div>
</div>

<script>
(function() {
  function switchTab(tab) {
    document.querySelectorAll('#creds-sidebar .sidebar-btn').forEach(function(b) {
      b.classList.remove('border-cyan-400', 'text-cyan-400', 'bg-cyan-950/40');
      b.classList.add('border-transparent', 'text-slate-400');
      b.classList.remove('bg-cyan-950/40');
    });
    var btn = document.querySelector('#creds-sidebar .sidebar-btn[data-tab="' + tab + '"]');
    if (btn) {
      btn.classList.remove('border-transparent', 'text-slate-400');
      btn.classList.add('border-cyan-400', 'text-cyan-400', 'bg-cyan-950/40');
    }
    document.querySelectorAll('#creds-tab-content .tab-panel').forEach(function(p) { p.classList.add('hidden'); });
    var panel = document.getElementById('tab-' + tab);
    if (panel) panel.classList.remove('hidden');
    history.replaceState(null, '', '#creds-' + tab);
  }
  document.querySelectorAll('#creds-sidebar .sidebar-btn').forEach(function(btn) {
    btn.addEventListener('click', function() { switchTab(this.dataset.tab); });
  });
  var initialTab = location.hash.replace('#creds-', '') || 'api-keys';
  if (!document.getElementById('tab-' + initialTab)) initialTab = 'api-keys';
  switchTab(initialTab);
  window.addEventListener('hashchange', function() {
    var t = location.hash.replace('#creds-', '') || 'api-keys';
    if (document.getElementById('tab-' + t)) switchTab(t);
  });
})();
</script>
