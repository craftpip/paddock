<% if (latest && Object.keys(latest).length > 0) { %>
<div class="grid grid-cols-2 lg:grid-cols-5 gap-3 mb-6">
  <div class="bg-slate-800/60 border border-slate-700 rounded-xl p-4">
    <div class="text-xs text-slate-500">Weekly Left</div>
    <div class="text-2xl font-bold text-emerald-400"><%= latest.weekly_pct_left || '?' %>%</div>
  </div>
  <div class="bg-slate-800/60 border border-slate-700 rounded-xl p-4">
    <div class="text-xs text-slate-500">Hourly Left</div>
    <div class="text-2xl font-bold text-cyan-400"><%= latest.hourly_pct_left || '?' %>%</div>
  </div>
  <div class="bg-slate-800/60 border border-slate-700 rounded-xl p-4">
    <div class="text-xs text-slate-500">Total Tokens</div>
    <div class="text-2xl font-bold text-amber-400"><%= latest.total_tokens_k || '?' %>K</div>
  </div>
  <div class="bg-slate-800/60 border border-slate-700 rounded-xl p-4">
    <div class="text-xs text-slate-500">Tokens Delta</div>
    <div class="text-lg font-bold text-purple-400"><%= latest.tokens_delta_k || '?' %>K</div>
  </div>
  <div class="bg-slate-800/60 border border-slate-700 rounded-xl p-4">
    <div class="text-xs text-slate-500">Plan</div>
    <div class="text-lg font-bold text-slate-200"><%= latest.plan || '?' %></div>
  </div>
</div>

<div class="bg-slate-800/60 border border-slate-700 rounded-xl p-4 mb-6">
  <div class="flex items-center justify-between mb-3">
    <div class="text-xs text-slate-500 uppercase tracking-wider">Weekly Reset</div>
    <div class="text-sm text-slate-300">
      <%= latest.weekly_reset_in || '?' %>
    </div>
  </div>
  <div class="flex items-center justify-between mb-3">
    <div class="text-xs text-slate-500 uppercase tracking-wider">Hourly Reset</div>
    <div class="text-sm text-slate-300">
      <%= latest.hourly_reset_in || '?' %>
    </div>
  </div>
</div>

<% if (rows && rows.length > 1) { %>
<div class="bg-slate-800/60 border border-slate-700 rounded-xl p-4">
  <div class="text-xs text-slate-500 uppercase tracking-wider mb-3">History (last 50 rows)</div>
  <div class="overflow-x-auto max-h-96 overflow-y-auto">
    <table class="w-full text-xs">
      <thead>
        <tr class="text-slate-500 border-b border-slate-700 sticky top-0 bg-slate-800">
          <th class="text-left py-2 px-2">Timestamp</th>
          <th class="text-right py-2 px-2">Weekly%</th>
          <th class="text-right py-2 px-2">Hourly%</th>
          <th class="text-right py-2 px-2">Tokens(K)</th>
          <th class="text-right py-2 px-2">Delta(K)</th>
          <th class="text-left py-2 px-2">Plan</th>
        </tr>
      </thead>
      <tbody>
        <% const recentRows = rows.slice(-50); for (const row of recentRows) { %>
        <tr class="border-b border-slate-800 hover:bg-slate-700/30">
          <td class="py-1.5 px-2 font-mono"><%= (row.timestamp || '').slice(-8) %></td>
          <td class="py-1.5 px-2 text-right"><%= row.weekly_pct_left || '' %></td>
          <td class="py-1.5 px-2 text-right"><%= row.hourly_pct_left || '' %></td>
          <td class="py-1.5 px-2 text-right"><%= row.total_tokens_k || '' %></td>
          <td class="py-1.5 px-2 text-right"><%= row.tokens_delta_k || '' %></td>
          <td class="py-1.5 px-2"><%= row.plan || '' %></td>
        </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
<% } %>

<% } else { %>
<div class="text-center py-20 text-slate-500">
  <p class="text-lg font-semibold">No usage data yet</p>
  <p class="text-sm mt-2">Run record-usage.sh or wait for the cron job.</p>
  <button hx-post="/usage/refresh" hx-target="#usage-content"
          class="mt-4 bg-cyan-700 hover:bg-cyan-600 text-white px-4 py-2 rounded-lg text-sm">
    Collect Data Now
  </button>
</div>
<% } %>
