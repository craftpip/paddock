<tr id="bt-<%= name %>" class="hover:bg-slate-700/30 transition-colors">
  <td class="py-2.5 px-3 font-medium text-slate-200"><%= name %></td>
  <td class="py-2.5 px-3 font-mono text-xs text-slate-400"><%= mask_key(token) %></td>
  <td class="py-2.5 px-3">
    <span class="inline-flex items-center gap-1.5 bg-cyan-950/50 text-cyan-300 px-2 py-0.5 rounded-md text-xs font-medium">
      <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
      <%= platform %>
    </span>
  </td>
  <td class="py-2.5 px-3 text-right">
    <button hx-post="/credentials/bot-tokens/<%= name %>/delete" hx-target="#bt-<%= name %>" hx-swap="delete"
            class="text-red-400 hover:text-red-300 hover:bg-red-950/30 px-2 py-1 rounded transition-colors text-xs font-medium"
            onclick="return confirm('Delete bot token <%= name %>?')">Delete</button>
  </td>
</tr>