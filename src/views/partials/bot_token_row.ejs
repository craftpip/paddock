<tr id="bt-<%= name %>" class="border-b border-slate-700">
  <td class="py-2 px-3"><%= name %></td>
  <td class="py-2 px-3 font-mono text-xs"><%= mask_key(token) %></td>
  <td class="py-2 px-3 text-right">
    <button hx-post="/credentials/bot-tokens/<%= name %>/delete" hx-target="#bt-<%= name %>" hx-swap="delete"
            class="text-red-400 hover:text-red-300 text-xs" onclick="return confirm('Delete bot token <%= name %>?')">Delete</button>
  </td>
</tr>
