<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold">Backups</h1>
  <span class="text-sm text-slate-400"><%= backups.length %> backup<%= backups.length !== 1 ? 's' : '' %></span>
</div>

<div class="bg-slate-800/60 border border-slate-700 rounded-xl p-4 mb-6">
  <div class="text-sm font-medium text-slate-300 mb-3">Quick Backup</div>
  <div class="flex flex-wrap gap-2">
    <% for (const v of vms) { %>
    <button onclick="doQuickBackup('<%= v.name %>', this)"
            class="relative flex items-center gap-2 bg-slate-700 hover:bg-slate-600 text-slate-200 px-3 py-1.5 rounded-lg text-xs transition-colors">
      <span class="w-1.5 h-1.5 rounded-full flex-shrink-0 <%= v.status === 'running' ? 'bg-emerald-400' : 'bg-slate-500' %>"></span>
      <span><%= v.name %></span>
      <span class="text-slate-500">(<%= v.agent %>)</span>
    </button>
    <% } %>
    <% if (vms.length === 0) { %>
    <span class="text-xs text-slate-500">No agents found</span>
    <% } %>
  </div>
</div>

<% if (backups.length === 0) { %>
<div class="text-center py-20 text-slate-500">
  <svg class="w-10 h-10 mx-auto mb-3 text-slate-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"/></svg>
  <p class="text-lg font-semibold">No backups yet</p>
  <p class="text-sm mt-1">Use the quick backup buttons above or create one from an agent page.</p>
</div>
<% } else { %>

<div class="border border-slate-800 rounded-xl overflow-hidden">
  <div class="overflow-x-auto">
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-slate-800 text-left text-slate-500">
          <th class="px-4 py-2.5 font-medium">Agent</th>
          <th class="px-4 py-2.5 font-medium">Type</th>
          <th class="px-4 py-2.5 font-medium">Created</th>
          <th class="px-4 py-2.5 font-medium hidden sm:table-cell">Size</th>
          <th class="px-4 py-2.5 font-medium text-right">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% for (const b of backups) { %>
        <tr class="border-b border-slate-800/50 hover:bg-slate-800/30 group" id="backup-row-<%= b.file %>">
          <td class="px-4 py-2.5">
            <div class="flex items-center gap-2">
              <% if (!b.containerExists) { %>
              <span class="flex-shrink-0 w-2 h-2 rounded-full bg-amber-400" title="Agent not found"></span>
              <% } %>
              <span class="<%= b.containerExists ? '' : 'text-slate-500' %>"><%= b.vm %></span>
              <% if (!b.containerExists) { %>
              <span class="inline-block bg-amber-900/40 text-amber-400 px-1.5 py-0.5 rounded text-[10px] font-medium">orphan</span>
              <% } %>
            </div>
          </td>
          <td class="px-4 py-2.5">
            <% if (b.type === 'picoclaw') { %>
            <span class="inline-block bg-purple-900/50 text-purple-300 px-2 py-0.5 rounded text-[10px] font-medium">PicoClaw</span>
            <% } else { %>
            <span class="inline-block bg-cyan-900/50 text-cyan-300 px-2 py-0.5 rounded text-[10px] font-medium">OpenClaw</span>
            <% } %>
          </td>
          <td class="px-4 py-2.5">
            <div class="flex flex-col">
              <span class="text-slate-300"><%= b.displayDate %> <span class="text-slate-500"><%= b.displayTime %></span></span>
              <span class="text-[11px] text-slate-600"><%= b.relativeTime %></span>
            </div>
          </td>
          <td class="px-4 py-2.5 text-slate-500 hidden sm:table-cell"><%= b.size_hr %></td>
          <td class="px-4 py-2.5 text-right">
            <div class="flex items-center justify-end gap-1 opacity-40 group-hover:opacity-100 transition-opacity">
              <a href="/backups/<%= b.file %>/download"
                 class="px-2 py-1 text-xs text-slate-400 hover:text-white hover:bg-slate-700 rounded transition-colors">Download</a>
              <button onclick="doDeleteBackup('<%= b.file.replace(/'/g, "\\'") %>')"
                      class="px-2 py-1 text-xs text-red-400 hover:text-red-300 hover:bg-slate-700 rounded transition-colors">Delete</button>
            </div>
          </td>
        </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<% } %>

<script>
function doQuickBackup(name, btn) {
  btn.disabled = true;
  btn.style.opacity = '0.5';
  fetch('/backups/' + encodeURIComponent(name) + '/create', { method: 'POST', credentials: 'same-origin' })
    .then(function(r) {
      if (!r.ok) throw new Error('Failed');
      VMF.toast('Backup created for ' + name, 'success');
      setTimeout(function() { location.reload(); }, 1200);
    })
    .catch(function() { VMF.toast('Backup failed', 'error'); })
    .finally(function() { btn.disabled = false; btn.style.opacity = ''; });
}
function doDeleteBackup(file) {
  VMF.confirm({ title: 'Delete Backup', message: 'Delete ' + file + ' permanently?', danger: true, confirmText: 'Delete' }, function() {
    fetch('/backups/' + encodeURIComponent(file) + '/delete', { method: 'POST', credentials: 'same-origin' })
      .then(function(r) {
        if (!r.ok) throw new Error('Failed');
        var row = document.getElementById('backup-row-' + file);
        if (row) row.remove();
        VMF.toast('Backup deleted', 'success');
      })
      .catch(function() { VMF.toast('Delete failed', 'error'); });
  });
}
</script>
