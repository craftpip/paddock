<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold">Backups</h1>
  <span class="text-sm text-slate-400"><%= Object.keys(grouped).length %> VM<%= Object.keys(grouped).length !== 1 ? 's' : '' %> backed up</span>
</div>

<% const groupKeys = Object.keys(grouped); if (groupKeys.length === 0) { %>
<div class="text-center py-20 text-slate-500">
  <p class="text-lg font-semibold">No backups yet</p>
  <p class="text-sm mt-2">Create a backup from a VM detail page or below.</p>
</div>
<% } else { %>

<% for (const vmName of groupKeys) { const vmBackups = grouped[vmName]; %>
<div class="bg-slate-800/60 border border-slate-700 rounded-xl p-4 mb-4">
  <div class="flex items-center justify-between mb-3">
    <div>
      <a href="/vm/<%= vmName %>" class="font-semibold hover:text-cyan-400"><%= vmName %></a>
      <span class="text-xs text-slate-500 ml-2"><%= vmBackups.length %> backup<%= vmBackups.length !== 1 ? 's' : '' %></span>
    </div>
    <button hx-post="/backups/<%= vmName %>/create" hx-target="#toast" hx-swap="innerHTML"
            class="bg-cyan-700 hover:bg-cyan-600 text-white px-3 py-1.5 rounded text-xs">
      Backup Now
    </button>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full text-xs">
      <thead>
        <tr class="text-slate-500 border-b border-slate-700">
          <th class="text-left py-2 px-2">Timestamp</th>
          <th class="text-left py-2 px-2">Size</th>
          <th class="text-right py-2 px-2">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% for (const b of vmBackups) { %>
        <tr class="border-b border-slate-800 hover:bg-slate-700/30">
          <td class="py-2 px-2 font-mono"><%= b.timestamp %></td>
          <td class="py-2 px-2 text-slate-400"><%= b.size_hr %></td>
          <td class="py-2 px-2 text-right space-x-2">
            <a href="/backups/<%= b.file %>/download" class="text-cyan-400 hover:text-cyan-300">Download</a>
            <button hx-post="/backups/<%= vmName %>/restore"
                    hx-confirm="Restore <%= vmName %> from backup <%= b.timestamp %>? Container will be restarted."
                    hx-target="#toast" class="text-amber-400 hover:text-amber-300">Restore</button>
            <button hx-post="/backups/<%= b.file %>/delete" hx-confirm="Delete backup <%= b.file %>?"
                    class="text-red-400 hover:text-red-300">Delete</button>
          </td>
        </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
<% } %>

<% } %>

<div class="mt-6 bg-slate-800/60 border border-slate-700 rounded-xl p-4">
  <div class="text-sm text-slate-300 mb-2">Quick Backup</div>
  <div class="flex flex-wrap gap-2">
    <% for (const v of vms) { %>
    <button hx-post="/backups/<%= v.name %>/create" hx-target="#toast"
            class="bg-slate-700 hover:bg-slate-600 text-slate-200 px-3 py-1.5 rounded text-xs">
      <%= v.name %>
    </button>
    <% } %>
  </div>
</div>
