<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>VM Friends — Login</title>
  <script>window.tailwind={config:{darkMode:'class'}}</script>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    html.light{--bg-page:#f8fafc;--bg-card:#ffffff;--text-primary:#1e293b;--text-secondary:#475569;--border:#e2e8f0}
    html.light body{background-color:var(--bg-page);color:var(--text-primary)}
    html.light input{background-color:#f1f5f9;border-color:var(--border);color:var(--text-primary)}
  </style>
</head>
<body class="bg-slate-900 text-slate-100 font-sans antialiased min-h-screen flex items-center justify-center">
  <div class="w-full max-w-sm mx-auto px-4">
    <div class="text-center mb-8">
      <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-slate-800 border border-slate-700 mb-4">
        <svg class="w-8 h-8 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
      </div>
      <h1 class="text-xl font-bold text-white">VM Friends</h1>
      <p class="text-sm text-slate-500 mt-1">Agent Management System</p>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="bg-red-900/30 border border-red-700 text-red-200 px-4 py-3 rounded-lg text-sm mb-4"><%= error %></div>
    <% } %>

    <form method="POST" action="/login" class="space-y-4">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div>
        <label class="block text-sm font-medium text-slate-300 mb-2">Password</label>
        <input type="password" name="password" autofocus required
          class="w-full px-4 py-3 bg-slate-950 border border-slate-700 rounded-xl text-white text-sm focus:border-cyan-500 focus:outline-none focus:ring-1 focus:ring-cyan-500"
          placeholder="Enter password">
      </div>
      <button type="submit" class="w-full px-4 py-3 bg-cyan-600 hover:bg-cyan-500 text-white rounded-xl text-sm font-medium transition-colors focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:ring-offset-2 focus:ring-offset-slate-900">
        Sign In
      </button>
    </form>
  </div>
</body>
</html>
