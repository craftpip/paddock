<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold">Usage Dashboard</h1>
  <button hx-post="/usage/refresh" hx-target="#usage-content" hx-indicator="#usage-spinner"
          class="bg-cyan-700 hover:bg-cyan-600 text-white px-4 py-2 rounded-lg text-sm">
    <span id="usage-spinner" class="htmx-indicator">⏳</span> Refresh Data
  </button>
</div>

<div id="usage-content">
  <%- include('partials/usage_stats', { latest, rows }) %>
</div>

<% if (chart_labels !== '[]') { %>
<div class="bg-slate-800/60 border border-slate-700 rounded-xl p-4 mb-6">
  <div class="text-xs text-slate-500 uppercase tracking-wider mb-3">Usage Over Time</div>
  <canvas id="usage-chart" height="100"></canvas>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
<script>
(function() {
  var ctx = document.getElementById('usage-chart').getContext('2d');
  new Chart(ctx, {
    type: 'line',
    data: {
      labels: <%- chart_labels %>,
      datasets: [
        {
          label: 'Weekly % Left',
          data: <%- chart_weekly %>,
          borderColor: '#34d399',
          backgroundColor: 'rgba(52, 211, 153, 0.1)',
          fill: true,
          tension: 0.3,
          pointRadius: 1,
        },
        {
          label: 'Hourly % Left',
          data: <%- chart_hourly %>,
          borderColor: '#22d3ee',
          backgroundColor: 'rgba(34, 211, 238, 0.1)',
          fill: true,
          tension: 0.3,
          pointRadius: 1,
        },
        {
          label: 'Total Tokens (K)',
          data: <%- chart_tokens %>,
          borderColor: '#fbbf24',
          backgroundColor: 'rgba(251, 191, 36, 0.1)',
          fill: true,
          tension: 0.3,
          pointRadius: 1,
          yAxisID: 'y1',
        },
      ],
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      interaction: { mode: 'index', intersect: false },
      plugins: {
        legend: {
          labels: { color: '#94a3b8', font: { size: 11 } },
        },
      },
      scales: {
        x: {
          ticks: { color: '#64748b', maxTicksLimit: 20, font: { size: 10 } },
          grid: { color: 'rgba(100, 116, 139, 0.15)' },
        },
        y: {
          beginAtZero: true,
          ticks: { color: '#64748b', font: { size: 10 } },
          grid: { color: 'rgba(100, 116, 139, 0.15)' },
        },
        y1: {
          beginAtZero: true,
          position: 'right',
          ticks: { color: '#64748b', font: { size: 10 } },
          grid: { display: false },
        },
      },
    },
  });
})();
</script>
<% } %>
