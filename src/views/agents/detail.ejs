<% if (typeof flash !== 'undefined' && flash) { %>
  <script>window._flash={<%= JSON.stringify({message: flash.message, type: flash.type}) %>};</script>
<% } %>

<!-- Sidebar + Content Layout -->
<div class="flex gap-0 flex-1 min-h-0" id="agent-layout">
  <!-- Left Sidebar -->
  <aside class="w-56 flex-shrink-0 border-r border-slate-800 overflow-y-auto py-6 px-4" id="agent-sidebar">
    <a href="/agents" class="text-xs text-slate-500 hover:text-slate-300 transition-colors block mb-4">&larr; Back to fleet</a>

    <%- include('partials/sidebar_status', { agent, csrfToken }) %>

    <div class="space-y-0.5">
      <button class="sidebar-btn w-full text-left px-3 py-2 text-sm font-medium rounded-lg border-l-2 border-cyan-400 text-cyan-400 bg-slate-800/50 whitespace-nowrap" data-tab="overview">Overview</button>
      <button class="sidebar-btn w-full text-left px-3 py-2 text-sm font-medium rounded-lg border-l-2 border-transparent text-slate-400 hover:text-slate-200 hover:bg-slate-800/50 whitespace-nowrap" data-tab="workspace">Workspace</button>
      <button class="sidebar-btn w-full text-left px-3 py-2 text-sm font-medium rounded-lg border-l-2 border-transparent text-slate-400 hover:text-slate-200 hover:bg-slate-800/50 whitespace-nowrap" data-tab="terminal">Terminal</button>
      <button class="sidebar-btn w-full text-left px-3 py-2 text-sm font-medium rounded-lg border-l-2 border-transparent text-slate-400 hover:text-slate-200 hover:bg-slate-800/50 whitespace-nowrap" data-tab="logs">Logs</button>
      <button class="sidebar-btn w-full text-left px-3 py-2 text-sm font-medium rounded-lg border-l-2 border-transparent text-slate-400 hover:text-slate-200 hover:bg-slate-800/50 whitespace-nowrap" data-tab="sessions">Sessions</button>
      <button class="sidebar-btn w-full text-left px-3 py-2 text-sm font-medium rounded-lg border-l-2 border-transparent text-slate-400 hover:text-slate-200 hover:bg-slate-800/50 whitespace-nowrap" data-tab="config">Config</button>
      <button class="sidebar-btn w-full text-left px-3 py-2 text-sm font-medium rounded-lg border-l-2 border-transparent text-slate-400 hover:text-slate-200 hover:bg-slate-800/50 whitespace-nowrap" data-tab="models">Models</button>
      <button class="sidebar-btn w-full text-left px-3 py-2 text-sm font-medium rounded-lg border-l-2 border-transparent text-slate-400 hover:text-slate-200 hover:bg-slate-800/50 whitespace-nowrap" data-tab="messaging">Messaging</button>
      <button class="sidebar-btn w-full text-left px-3 py-2 text-sm font-medium rounded-lg border-l-2 border-transparent text-slate-400 hover:text-slate-200 hover:bg-slate-800/50 whitespace-nowrap" data-tab="backups">Backups</button>
      <button class="sidebar-btn w-full text-left px-3 py-2 text-sm font-medium rounded-lg border-l-2 border-transparent text-slate-400 hover:text-slate-200 hover:bg-slate-800/50 whitespace-nowrap" data-tab="activity">Activity</button>
    </div>
  </aside>

  <!-- Tab Content -->
  <div id="tab-content" class="flex-1 min-w-0 overflow-y-auto p-6">
  <div id="tab-overview" class="tab-panel">
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
      <div class="border border-slate-800 rounded-xl p-4">
        <p class="text-xs text-slate-500 mb-1">Type</p>
        <p class="text-lg font-semibold text-white"><%= agent.agent_type %></p>
      </div>
      <div class="border border-slate-800 rounded-xl p-4">
        <p class="text-xs text-slate-500 mb-1">Runtime</p>
        <p class="text-lg font-semibold text-white"><%= agent.runtime_type %></p>
      </div>
      <div class="border border-slate-800 rounded-xl p-4">
        <p class="text-xs text-slate-500 mb-1">Model</p>
        <p class="text-lg font-semibold text-white truncate text-sm" title="<%= agent.default_model || 'Not configured' %>"><%= agent.default_model || 'Not configured' %></p>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
      <a href="#workspace" class="border border-slate-800 rounded-xl p-4 hover:border-slate-600 transition-colors group">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-lg bg-cyan-900/30 flex items-center justify-center text-cyan-400">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/></svg>
          </div>
          <div>
            <p class="font-medium text-white group-hover:text-cyan-400 transition-colors">Workspace</p>
            <p class="text-xs text-slate-500">Browse and manage files</p>
          </div>
        </div>
      </a>
      <a href="#terminal" class="border border-slate-800 rounded-xl p-4 hover:border-slate-600 transition-colors group">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-lg bg-emerald-900/30 flex items-center justify-center text-emerald-400">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          </div>
          <div>
            <p class="font-medium text-white group-hover:text-cyan-400 transition-colors">Terminal</p>
            <p class="text-xs text-slate-500">Open a shell session</p>
          </div>
        </div>
      </a>
    </div>

    <% if (activity.length > 0) { %>
    <div class="border border-slate-800 rounded-xl p-4">
      <h3 class="text-sm font-medium text-slate-300 mb-3">Recent Activity</h3>
      <div class="space-y-2">
        <% for (const event of activity.slice(0, 5)) { %>
          <div class="flex items-center justify-between text-xs gap-4">
            <div class="flex items-center gap-2 min-w-0">
              <span class="w-1.5 h-1.5 rounded-full flex-shrink-0 <%= event.status === 'ok' ? 'bg-emerald-400' : 'bg-red-400' %>"></span>
              <span class="text-slate-300"><%= event.action %></span>
              <% if (event.details) { %>
                <span class="text-slate-500 truncate"><%= event.details %></span>
              <% } %>
            </div>
            <span class="text-slate-600 flex-shrink-0"><%= new Date(event.timestamp).toLocaleDateString() %></span>
          </div>
        <% } %>
      </div>
    </div>
    <% } %>
  </div>

  <div id="tab-workspace" class="tab-panel hidden">
    <div hx-get="/agents/<%= agent.name %>/workspace<% if (locals.workspacePath) { %>?path=<%= encodeURIComponent(workspacePath) %><% } %>" hx-trigger="load" hx-swap="innerHTML">
      <div class="space-y-3">
        <div class="skeleton h-10 w-full"></div>
        <div class="skeleton h-8 w-3/4"></div>
        <div class="skeleton h-8 w-1/2"></div>
        <div class="skeleton h-8 w-2/3"></div>
      </div>
    </div>
  </div>

  <div id="tab-terminal" class="tab-panel hidden">
    <div hx-get="/agents/<%= agent.name %>/terminal" hx-trigger="load" hx-swap="innerHTML">
      <div class="skeleton h-[500px] w-full"></div>
    </div>
  </div>

  <div id="tab-logs" class="tab-panel hidden">
    <div hx-get="/agents/<%= agent.name %>/logs" hx-trigger="load" hx-swap="innerHTML">
      <div class="skeleton h-64 w-full"></div>
    </div>
  </div>

  <div id="tab-sessions" class="tab-panel hidden">
    <div hx-get="/agents/<%= agent.name %>/sessions" hx-trigger="load" hx-swap="innerHTML">
      <div class="space-y-3">
        <div class="skeleton h-12 w-full"></div>
        <div class="skeleton h-12 w-full"></div>
        <div class="skeleton h-12 w-full"></div>
      </div>
    </div>
  </div>

  <div id="tab-config" class="tab-panel hidden">
    <div hx-get="/agents/<%= agent.name %>/config" hx-trigger="load" hx-swap="innerHTML">
      <div class="skeleton h-64 w-full"></div>
    </div>
  </div>

  <div id="tab-models" class="tab-panel hidden">
    <div hx-get="/agents/<%= agent.name %>/models" hx-trigger="load" hx-swap="innerHTML">
      <div class="skeleton h-64 w-full"></div>
    </div>
  </div>

  <div id="tab-messaging" class="tab-panel hidden">
    <div hx-get="/agents/<%= agent.name %>/messaging" hx-trigger="load" hx-swap="innerHTML">
      <div class="skeleton h-64 w-full"></div>
    </div>
  </div>

  <div id="tab-backups" class="tab-panel hidden">
    <div hx-get="/agents/<%= agent.name %>/backups" hx-trigger="load" hx-swap="innerHTML">
      <div class="space-y-3">
        <div class="skeleton h-12 w-full"></div>
        <div class="skeleton h-12 w-full"></div>
      </div>
    </div>
  </div>

  <div id="tab-activity" class="tab-panel hidden">
    <div hx-get="/agents/<%= agent.name %>/activity" hx-trigger="load" hx-swap="innerHTML">
      <div class="space-y-3">
        <div class="skeleton h-12 w-full"></div>
        <div class="skeleton h-12 w-full"></div>
        <div class="skeleton h-12 w-full"></div>
      </div>
    </div>
  </div>
</div>

<script>
function VMFswitchTab(tab) {
  document.querySelectorAll('.sidebar-btn').forEach(function(b) {
    b.classList.remove('border-cyan-400', 'text-cyan-400', 'bg-slate-800/50');
    b.classList.add('border-transparent', 'text-slate-400');
  });
  var btn = document.querySelector('.sidebar-btn[data-tab="' + tab + '"]');
  if (btn) {
    btn.classList.remove('border-transparent', 'text-slate-400');
    btn.classList.add('border-cyan-400', 'text-cyan-400', 'bg-slate-800/50');
  }
  document.querySelectorAll('.tab-panel').forEach(function(p) { p.classList.add('hidden'); });
  var panel = document.getElementById('tab-' + tab);
  if (panel) panel.classList.remove('hidden');
  history.replaceState(null, '', '#' + tab);
  var cmEl = panel ? panel.querySelector('.CodeMirror') : null;
  if (cmEl && cmEl.CodeMirror) cmEl.CodeMirror.refresh();
}

document.querySelectorAll('.sidebar-btn').forEach(function(btn) {
  btn.addEventListener('click', function() { VMFswitchTab(this.dataset.tab); });
});

var initialTab = location.hash.replace('#', '') || 'overview';
<% if (workspacePath) { %>if (!location.hash) initialTab = 'workspace';<% } %>
if (!document.getElementById('tab-' + initialTab)) initialTab = 'overview';
VMFswitchTab(initialTab);

window.addEventListener('hashchange', function() {
  var t = location.hash.replace('#', '') || 'overview';
  if (document.getElementById('tab-' + t)) VMFswitchTab(t);
});

document.querySelectorAll('#sidebar-status-block ~ .flex.gap-2.mb-6').forEach(function(el) { el.remove(); });
</script>
