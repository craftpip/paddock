<div class="border border-slate-800 rounded-xl overflow-hidden">
  <div class="flex items-center justify-between px-4 py-2 border-b border-slate-800 bg-slate-800/30">
    <span class="text-sm text-slate-300 font-medium">Container Logs</span>
    <div class="flex items-center gap-2">
      <span id="log-live-dot" class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
      <select id="log-tail" class="px-2 py-1 bg-slate-950 border border-slate-700 rounded text-xs text-white focus:outline-none">
        <option value="50">50 lines</option>
        <option value="100" selected>100 lines</option>
        <option value="500">500 lines</option>
        <option value="1000">1000 lines</option>
      </select>
      <button onclick="toggleAutoScroll()" id="log-scroll-btn" class="px-2 py-1 bg-cyan-700 hover:bg-cyan-600 text-white rounded text-xs transition-colors">↓ Auto-scroll</button>
      <button onclick="refreshLogs()" class="px-2 py-1 bg-slate-700 hover:bg-slate-600 text-white rounded text-xs transition-colors">Refresh</button>
    </div>
  </div>
  <div class="relative">
    <pre id="log-output" class="p-4 text-xs text-slate-300 overflow-auto max-h-96 font-mono whitespace-pre-wrap"><%= logs %></pre>
  </div>
</div>
<script>
(function() {
  var logTimer = null;
  var logOutput = document.getElementById('log-output');
  var scrollBtn = document.getElementById('log-scroll-btn');
  var autoScroll = true;

  function isAtBottom() {
    return logOutput.scrollHeight - logOutput.scrollTop - logOutput.clientHeight < 30;
  }

  function scrollToBottom() {
    logOutput.scrollTop = logOutput.scrollHeight;
  }

  function updateScrollBtn() {
    if (autoScroll) {
      scrollBtn.textContent = '↓ Auto-scroll ON';
      scrollBtn.className = 'px-2 py-1 bg-cyan-700 hover:bg-cyan-600 text-white rounded text-xs transition-colors';
    } else {
      scrollBtn.textContent = '↓ Auto-scroll OFF';
      scrollBtn.className = 'px-2 py-1 bg-slate-700 hover:bg-slate-600 text-white rounded text-xs transition-colors';
    }
  }

  function toggleAutoScroll() {
    autoScroll = !autoScroll;
    if (autoScroll) scrollToBottom();
    updateScrollBtn();
  }

  logOutput.addEventListener('scroll', function() {
    if (autoScroll && !isAtBottom()) {
      autoScroll = false;
      updateScrollBtn();
    }
  });

  function refreshLogs() {
    var tail = document.getElementById('log-tail').value;
    fetch('/agents/<%= agent.name %>/logs?tail=' + tail + '&raw=1')
      .then(function(r) { return r.text(); })
      .then(function(text) {
        logOutput.textContent = text;
        if (autoScroll) scrollToBottom();
      });
  }

  function startAutoRefresh() {
    stopAutoRefresh();
    logTimer = setInterval(refreshLogs, 5000);
  }

  function stopAutoRefresh() {
    if (logTimer) { clearInterval(logTimer); logTimer = null; }
  }

  window.refreshLogs = refreshLogs;
  window.toggleAutoScroll = toggleAutoScroll;
  startAutoRefresh();
  setTimeout(function() { scrollToBottom(); updateScrollBtn(); }, 100);

  var observer = new IntersectionObserver(function(entries) {
    entries.forEach(function(e) {
      e.isIntersecting ? startAutoRefresh() : stopAutoRefresh();
    });
  });
  observer.observe(logOutput);
})();
</script>
