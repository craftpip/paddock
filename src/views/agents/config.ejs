<% if (config) { %>
<div class="border border-slate-800 rounded-xl overflow-hidden">
  <div class="px-4 py-2 border-b border-slate-800 bg-slate-800/30">
    <span class="text-sm text-slate-300 font-medium">Agent Configuration</span>
    <span class="text-xs text-slate-500 ml-2">(secrets redacted)</span>
  </div>
  <pre class="p-4 text-xs text-slate-300 overflow-auto max-h-96 font-mono"><%= JSON.stringify(config, null, 2) %></pre>
</div>
<% } else { %>
<p class="text-slate-500 text-sm">No configuration found for this agent.</p>
<% } %>
