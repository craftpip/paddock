<% if (config) { %>
<div class="border border-slate-800 rounded-xl overflow-hidden">
  <div class="flex items-center justify-between px-4 py-2 border-b border-slate-800 bg-slate-800/30">
    <div>
      <span class="text-sm text-slate-300 font-medium">Agent Configuration</span>
      <span class="text-xs text-slate-500 ml-2">openclaw.json</span>
    </div>
    <div class="flex items-center gap-2">
      <span id="config-status" class="text-xs text-slate-500"></span>
      <button id="config-save" onclick="saveConfig()" disabled class="px-3 py-1.5 bg-cyan-600 hover:bg-cyan-500 text-white rounded text-sm transition-colors disabled:opacity-40 disabled:cursor-not-allowed">Save</button>
    </div>
  </div>
  <div id="config-editor-wrapper"></div>
  <textarea id="config-editor" class="hidden"><%= configRaw %></textarea>
</div>
<script>
(function() {
  var textarea = document.getElementById('config-editor');
  if (!textarea || !window.CodeMirror) return;
  var wrapper = document.getElementById('config-editor-wrapper');
  if (wrapper.querySelector('.CodeMirror')) return;
  var saveBtn = document.getElementById('config-save');
  var status = document.getElementById('config-status');

  var cm = CodeMirror(wrapper, {
    value: textarea.value,
    mode: 'application/json',
    theme: 'default',
    lineNumbers: true,
    matchBrackets: true,
    autoCloseBrackets: true,
    lineWrapping: true,
    indentUnit: 2,
    tabSize: 2,
    readOnly: false
  });
  cm.getWrapperElement().classList.add('cm-config');
  cm.refresh();

  var original = cm.getValue();

  cm.on('change', function() {
    var dirty = cm.getValue() !== original;
    saveBtn.disabled = !dirty;
    status.textContent = dirty ? 'Unsaved changes' : '';
    status.className = 'text-xs ' + (dirty ? 'text-amber-400' : 'text-slate-500');
  });

  cm.on('blur', function() {
    try {
      JSON.parse(cm.getValue());
      status.textContent = 'Valid JSON';
      status.className = 'text-xs text-emerald-400';
    } catch (e) {
      status.textContent = 'Invalid JSON: ' + e.message;
      status.className = 'text-xs text-red-400';
    }
  });

  window.saveConfig = function() {
    var content = cm.getValue();
    try { JSON.parse(content); } catch (e) {
      status.textContent = 'Invalid JSON: ' + e.message;
      status.className = 'text-xs text-red-400';
      VMF.toast('Invalid JSON: ' + e.message, 'error');
      return;
    }
    saveBtn.textContent = 'Saving...';
    saveBtn.disabled = true;
    fetch('/agents/<%= agent.name %>/config', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ config: content, _csrf: '<%= csrfToken %>' })
    })
    .then(function(r) { return r.json(); })
    .then(function(result) {
      if (result.error) {
        VMF.toast('Error: ' + result.error, 'error');
        saveBtn.textContent = 'Save';
        saveBtn.disabled = false;
        return;
      }
      original = content;
      saveBtn.disabled = true;
      status.textContent = 'Saved';
      status.className = 'text-xs text-emerald-400';
      saveBtn.textContent = 'Save';
      saveBtn.disabled = false;
      VMF.toast('Config saved. Restart the agent to apply.', 'success');
    })
    .catch(function(err) {
      VMF.toast('Failed to save: ' + err.message, 'error');
      saveBtn.textContent = 'Save';
      saveBtn.disabled = false;
    });
  };

  document.addEventListener('keydown', function(e) {
    if ((e.ctrlKey || e.metaKey) && e.key === 's') {
      var panel = document.getElementById('tab-config');
      if (panel && !panel.classList.contains('hidden')) {
        e.preventDefault();
        saveConfig();
      }
    }
  });
})();
</script>
<% } else { %>
<p class="text-slate-500 text-sm">No configuration found for this agent.</p>
<% } %>
