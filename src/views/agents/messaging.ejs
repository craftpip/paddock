<% if (config) { %>
<textarea id="tg-config-data" class="hidden"><%= configRaw %></textarea>
<div class="space-y-4">
  <!-- Telegram Settings Card -->
  <div class="border border-slate-800 rounded-xl overflow-hidden">
    <div class="flex items-center justify-between px-4 py-2 border-b border-slate-800 bg-slate-800/30">
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-blue-400" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12s5.37 12 12 12 12-5.37 12-12S18.63 0 12 0zm5.95 7.47l-1.97 9.28c-.15.67-.54.83-1.09.52l-3.02-2.22-1.46 1.4c-.16.16-.3.3-.61.3l.22-3.06 5.56-5.02c.24-.22-.05-.33-.37-.14L8.68 13.3l-2.97-.93c-.65-.2-.66-.65.14-.96l11.61-4.48c.54-.2 1.01.13.83.96l-.17-.42z"/></svg>
        <span class="text-sm text-slate-300 font-medium">Telegram</span>
      </div>
      <div class="flex items-center gap-2">
        <span id="tg-status" class="text-xs text-slate-500"></span>
        <button id="tg-save" onclick="saveTelegramConfig()" disabled class="px-3 py-1.5 bg-cyan-600 hover:bg-cyan-500 text-white rounded text-sm transition-colors disabled:opacity-40 disabled:cursor-not-allowed">Save</button>
      </div>
    </div>
    <div class="p-4 space-y-4">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Bot Token -->
        <div>
          <label class="block text-xs font-medium text-slate-400 mb-1">Bot Token</label>
          <input type="password" id="tg-bot-token"
            class="w-full px-3 py-2 bg-slate-950 border border-slate-700 rounded-lg text-white text-sm font-mono focus:border-cyan-500 focus:outline-none focus:ring-1 focus:ring-cyan-500"
            placeholder="123456789:ABCdefGHI...">
        </div>
        <!-- DM Policy -->
        <div>
          <label class="block text-xs font-medium text-slate-400 mb-1">DM Policy</label>
          <select id="tg-dm-policy"
            class="w-full px-3 py-2 bg-slate-950 border border-slate-700 rounded-lg text-white text-sm focus:border-cyan-500 focus:outline-none focus:ring-1 focus:ring-cyan-500">
            <option value="allowlist">Allowlist — only allowed users</option>
            <option value="pairing">Pairing — users pair with the bot</option>
          </select>
        </div>
      </div>
      <!-- Allow From -->
      <div id="tg-allow-row">
        <label class="block text-xs font-medium text-slate-400 mb-1">Allowed User IDs</label>
        <!-- Saved user IDs as clickable pills -->
        <div id="tg-saved-ids" class="flex flex-wrap gap-2 mb-2"></div>
        <!-- Custom ID input -->
        <div class="flex gap-2">
          <input type="text" id="tg-custom-id" placeholder="Add custom user ID"
            class="flex-1 px-3 py-2 bg-slate-950 border border-slate-700 rounded-lg text-white text-sm font-mono focus:border-cyan-500 focus:outline-none focus:ring-1 focus:ring-cyan-500">
          <button type="button" id="tg-add-id-btn"
            class="px-3 py-2 bg-slate-700 hover:bg-slate-600 text-white rounded-lg text-sm transition-colors">+ Add</button>
        </div>
        <p class="text-xs text-slate-500 mt-1">Click a tag to toggle. Custom IDs are saved as "unnamed" in credentials.</p>
      </div>
    </div>
  </div>
</div>

<script>
(function() {
  var tgToken = document.getElementById('tg-bot-token');
  var tgPolicy = document.getElementById('tg-dm-policy');
  var tgAllowRow = document.getElementById('tg-allow-row');
  var tgSavedIds = document.getElementById('tg-saved-ids');
  var tgCustomId = document.getElementById('tg-custom-id');
  var tgAddBtn = document.getElementById('tg-add-id-btn');
  var tgSaveBtn = document.getElementById('tg-save');
  var tgStatus = document.getElementById('tg-status');

  var savedCreds = {};
  var originalTg = null;

  function getConfig() {
    var el = document.getElementById('tg-config-data');
    if (!el) return null;
    try { return JSON.parse(el.value); } catch (e) { return null; }
  }

  function setConfig(obj) {
    var el = document.getElementById('tg-config-data');
    if (el) el.value = JSON.stringify(obj, null, 2);
  }

  function getTelegram() {
    var cfg = getConfig();
    return (cfg && cfg.channels && cfg.channels.telegram) || {};
  }

  function snapshotTg() {
    return JSON.stringify(getTelegram());
  }

  // ── User ID pills ──────────────────────────────────────────────────────
  function loadSavedIds() {
    return fetch('/api/user-ids')
      .then(function(r) { return r.json(); })
      .then(function(data) { savedCreds = data; renderPills(); });
  }

  function renderPills() {
    var tg = getTelegram();
    var activeIds = tg.allowFrom || [];
    tgSavedIds.innerHTML = '';

    var byUid = {};
    for (var name in savedCreds) {
      var uid = savedCreds[name];
      if (!byUid[uid]) byUid[uid] = [];
      byUid[uid].push(name);
    }

    for (var uid in byUid) {
      var names = byUid[uid];
      var label = names[0] + ' (' + uid + ')';
      var isActive = activeIds.indexOf(uid) !== -1;
      var pill = document.createElement('button');
      pill.type = 'button';
      pill.setAttribute('data-uid', uid);
      pill.className = 'px-2.5 py-1 rounded-full text-xs font-medium transition-colors border ' +
        (isActive
          ? 'bg-cyan-600 border-cyan-500 text-white'
          : 'bg-slate-800 border-slate-700 text-slate-400 hover:border-slate-500 hover:text-slate-300');
      pill.textContent = label;
      pill.addEventListener('click', function() {
        toggleId(this.getAttribute('data-uid'));
      });
      tgSavedIds.appendChild(pill);
    }
  }

  function toggleId(uid) {
    var cfg = getConfig();
    if (!cfg) return;
    if (!cfg.channels) cfg.channels = {};
    if (!cfg.channels.telegram) cfg.channels.telegram = {};
    var ids = cfg.channels.telegram.allowFrom || [];
    var idx = ids.indexOf(uid);
    if (idx !== -1) ids.splice(idx, 1);
    else ids.push(uid);
    cfg.channels.telegram.allowFrom = ids.length ? ids : undefined;
    setConfig(cfg);
    renderPills();
    markDirty();
  }

  function addCustomId() {
    var uid = tgCustomId.value.trim();
    if (!uid) return;
    fetch('/api/user-ids', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ uid: uid })
    })
    .then(function(r) { return r.json(); })
    .then(function(result) {
      if (result.ok) {
        savedCreds[result.name] = uid;
        renderPills();
        var cfg = getConfig();
        if (!cfg) return;
        if (!cfg.channels) cfg.channels = {};
        if (!cfg.channels.telegram) cfg.channels.telegram = {};
        var ids = cfg.channels.telegram.allowFrom || [];
        if (ids.indexOf(uid) === -1) {
          ids.push(uid);
          cfg.channels.telegram.allowFrom = ids;
          setConfig(cfg);
          markDirty();
        }
        tgCustomId.value = '';
      }
    });
  }

  tgAddBtn.addEventListener('click', addCustomId);
  tgCustomId.addEventListener('keydown', function(e) {
    if (e.key === 'Enter') { e.preventDefault(); addCustomId(); }
  });

  // ── Populate fields ────────────────────────────────────────────────────
  function loadTelegramFields() {
    var tg = getTelegram();
    tgToken.value = tg.botToken || '';
    tgPolicy.value = tg.dmPolicy || 'allowlist';
    renderPills();
    updateAllowRow();
  }

  function updateAllowRow() {
    tgAllowRow.style.display = tgPolicy.value === 'pairing' ? 'none' : '';
  }

  // ── Change handlers ────────────────────────────────────────────────────
  tgToken.addEventListener('change', function() {
    var cfg = getConfig();
    if (!cfg) return;
    if (!cfg.channels) cfg.channels = {};
    if (!cfg.channels.telegram) cfg.channels.telegram = {};
    cfg.channels.telegram.botToken = tgToken.value;
    setConfig(cfg);
    markDirty();
  });

  tgPolicy.addEventListener('change', function() {
    var cfg = getConfig();
    if (!cfg) return;
    if (!cfg.channels) cfg.channels = {};
    if (!cfg.channels.telegram) cfg.channels.telegram = {};
    cfg.channels.telegram.dmPolicy = tgPolicy.value;
    if (tgPolicy.value === 'pairing') {
      cfg.channels.telegram.allowFrom = undefined;
    }
    setConfig(cfg);
    updateAllowRow();
    renderPills();
    markDirty();
  });

  // ── Dirty tracking ─────────────────────────────────────────────────────
  function markDirty() {
    var current = snapshotTg();
    var dirty = current !== originalTg;
    tgSaveBtn.disabled = !dirty;
    tgStatus.textContent = dirty ? 'Unsaved changes' : '';
    tgStatus.className = 'text-xs ' + (dirty ? 'text-amber-400' : 'text-slate-500');
  }

  // ── Save ───────────────────────────────────────────────────────────────
  window.saveTelegramConfig = function() {
    var configStr = document.getElementById('tg-config-data').value;
    try { JSON.parse(configStr); } catch (e) {
      VMF.toast('Invalid JSON: ' + e.message, 'error');
      return;
    }
    tgSaveBtn.textContent = 'Saving...';
    tgSaveBtn.disabled = true;
    fetch('/agents/<%= agent.name %>/config', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ config: configStr, _csrf: '<%= csrfToken %>' })
    })
    .then(function(r) { return r.json(); })
    .then(function(result) {
      if (result.error) {
        VMF.toast('Error: ' + result.error, 'error');
        tgSaveBtn.textContent = 'Save';
        tgSaveBtn.disabled = false;
        return;
      }
      originalTg = snapshotTg();
      tgSaveBtn.disabled = true;
      tgStatus.textContent = 'Saved';
      tgStatus.className = 'text-xs text-emerald-400';
      tgSaveBtn.textContent = 'Save';
      VMF.toast('Config saved. Restart the agent to apply.', 'success');
    })
    .catch(function(err) {
      VMF.toast('Failed to save: ' + err.message, 'error');
      tgSaveBtn.textContent = 'Save';
      tgSaveBtn.disabled = false;
    });
  };

  // ── Init ───────────────────────────────────────────────────────────────
  loadSavedIds().then(function() {
    loadTelegramFields();
    originalTg = snapshotTg();
  });
})();
</script>
<% } else { %>
<p class="text-slate-500 text-sm">No configuration found for this agent.</p>
<% } %>
