<% if (config) { %>
<div id="models-panel" hx-sync="closest hx-get|hx-post queue">
  <% var providers = (config.models && config.models.providers) || {}; %>
  <% var primary = (config.agents && config.agents.defaults && config.agents.defaults.model && config.agents.defaults.model.primary) || ''; %>
  <% var fallback = (config.agents && config.agents.defaults && config.agents.defaults.model && config.agents.defaults.model.fallback) || ''; %>
  <% var csrf = typeof csrfToken !== 'undefined' ? csrfToken : ''; %>

  <!-- Primary Model -->
  <div class="border border-slate-800 rounded-xl overflow-hidden mb-4">
    <div class="flex items-center justify-between px-4 py-3 border-b border-slate-800 bg-slate-800/30">
      <span class="text-sm text-slate-300 font-medium">Primary Model</span>
    </div>
    <div class="px-4 py-3 flex items-center justify-between">
      <span class="text-sm font-mono text-white truncate"><%= primary || '(none — click ★ Primary on a model below)' %></span>
      <span class="text-xs text-slate-500"><%= primary ? 'Active' : '' %></span>
    </div>
  </div>

  <!-- Fallback Model -->
  <div class="border border-slate-800 rounded-xl overflow-hidden mb-6">
    <div class="flex items-center justify-between px-4 py-3 border-b border-slate-800 bg-slate-800/30">
      <span class="text-sm text-slate-300 font-medium">Fallback Model</span>
      <% if (fallback) { %>
        <button hx-post="/agents/<%= agent.name %>/models/set-fallback"
                hx-vals='{"model": ""}'
                hx-target="#models-panel"
                hx-swap="outerHTML"
                hx-headers='{"x-csrf-token": "<%= csrf %>"}'
                class="text-xs text-red-400 hover:text-red-300 transition-colors">Remove</button>
      <% } %>
    </div>
    <div class="px-4 py-3">
      <span class="text-sm font-mono text-white truncate"><%= fallback || '(none)' %></span>
    </div>
  </div>

  <!-- Configured Providers -->
  <div class="space-y-4 mb-8">
    <% var providerKeys = Object.keys(providers); %>
    <% if (providerKeys.length === 0) { %>
      <div class="border border-slate-800 rounded-xl p-6 text-center">
        <p class="text-sm text-slate-500 mb-2">No providers configured yet</p>
        <p class="text-xs text-slate-600">Add one below</p>
      </div>
    <% } %>
    <% for (var pName of providerKeys) { %>
      <% var p = providers[pName]; %>
      <% var models = p.models || []; %>
      <div class="border border-slate-800 rounded-xl overflow-hidden">
        <div class="flex items-center justify-between px-4 py-2 border-b border-slate-800 bg-slate-800/30">
          <div class="flex items-center gap-2">
            <span class="text-sm text-slate-300 font-medium"><%= pName %></span>
            <span class="text-xs text-slate-500"><%= models.length %> model<%= models.length !== 1 ? 's' : '' %></span>
          </div>
          <button hx-post="/agents/<%= agent.name %>/models/remove-provider"
                  hx-vals='{"provider": "<%= pName %>"}'
                  hx-target="#models-panel"
                  hx-swap="outerHTML"
                  hx-headers='{"x-csrf-token": "<%= csrf %>"}'
                  hx-confirm="Remove provider '<%= pName %>'?"
                  class="text-xs text-red-400 hover:text-red-300 transition-colors">&times; Remove</button>
        </div>
        <% if (models.length > 0) { %>
          <div class="overflow-x-auto">
            <table class="w-full text-xs">
              <thead>
                <tr class="text-slate-500 border-b border-slate-700">
                  <th class="text-left py-2.5 px-4 font-medium text-xs">Model</th>
                  <th class="text-left py-2.5 px-4 font-medium text-xs">Input</th>
                  <th class="text-left py-2.5 px-4 font-medium text-xs">Context</th>
                  <th class="text-right py-2.5 px-4 font-medium text-xs">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% for (var m of models) { %>
                  <% var fullId = pName + '/' + m.id; %>
                  <tr class="border-b border-slate-800/50 hover:bg-slate-800/20">
                    <td class="py-2.5 px-4 font-mono text-white text-sm"><%= m.id %>
                      <% if (fullId === primary) { %><span class="text-cyan-400 text-xs ml-1">★</span><% } %>
                      <% if (fullId === fallback) { %><span class="text-amber-400 text-xs ml-1">⤵</span><% } %>
                    </td>
                    <td class="py-2.5 px-4 text-slate-400 text-sm"><%= Array.isArray(m.input) ? m.input.join(', ') : m.input || 'text' %></td>
                    <td class="py-2.5 px-4 text-slate-500 text-sm"><%= m.contextWindow ? (m.contextWindow >= 1000 ? (m.contextWindow / 1000).toFixed(0) + 'K' : m.contextWindow) : '—' %></td>
                    <td class="py-2.5 px-4 text-right">
                      <div class="flex items-center justify-end gap-2">
                        <button hx-post="/agents/<%= agent.name %>/models/set-primary"
                                hx-vals='{"model": "<%= fullId %>"}'
                                hx-target="#models-panel"
                                hx-swap="outerHTML"
                                hx-headers='{"x-csrf-token": "<%= csrf %>"}'
                                class="px-3 py-1.5 text-xs font-medium <%= fullId === primary ? 'bg-cyan-700 text-cyan-200' : 'bg-slate-700 hover:bg-slate-600 text-slate-300' %> rounded-lg transition-colors">★ Primary</button>
                        <button hx-post="/agents/<%= agent.name %>/models/set-fallback"
                                hx-vals='{"model": "<%= fullId %>"}'
                                hx-target="#models-panel"
                                hx-swap="outerHTML"
                                hx-headers='{"x-csrf-token": "<%= csrf %>"}'
                                class="px-3 py-1.5 text-xs font-medium <%= fullId === fallback ? 'bg-amber-700 text-amber-200' : 'bg-slate-700 hover:bg-slate-600 text-slate-300' %> rounded-lg transition-colors">⤵ FB</button>
                      </div>
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="p-4 text-xs text-slate-500">No models — restart the agent to fetch model list</div>
        <% } %>
      </div>
    <% } %>
  </div>

  <!-- Add Provider -->
  <div class="border border-slate-800 rounded-xl overflow-hidden">
    <div class="px-4 py-2 border-b border-slate-800 bg-slate-800/30">
      <span class="text-sm text-slate-300 font-medium">Add Provider</span>
    </div>
    <div class="p-4">
      <!-- OAuth Modal -->
      <div id="oauth-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60" onclick="closeOAuthModal()">
        <div class="bg-slate-800 border border-slate-700 rounded-xl shadow-2xl p-6 max-w-lg w-full mx-4" onclick="event.stopPropagation()">
          <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-semibold text-white" id="oauth-modal-title">OAuth Login</h3>
            <button onclick="closeOAuthModal()" class="text-slate-500 hover:text-white transition-colors text-xl leading-none">&times;</button>
          </div>
          <div class="space-y-3">
            <div>
              <p class="text-sm text-slate-400 mb-1">Open this URL in your <strong class="text-white">local</strong> browser:</p>
              <a id="oauth-modal-url" href="#" target="_blank"
                 class="text-sm text-cyan-400 hover:text-cyan-300 break-all block bg-slate-950 rounded-lg p-3 border border-slate-700 font-mono"></a>
            </div>
            <div class="flex items-center gap-2">
              <p class="text-sm text-slate-400">Code:</p>
              <span id="oauth-modal-code" class="text-lg font-mono text-white font-bold bg-slate-950 rounded-lg px-3 py-1 border border-slate-700 select-all"></span>
              <button onclick="copyOAuthCode()" class="text-xs text-cyan-400 hover:text-cyan-300 transition-colors">Copy</button>
            </div>
            <button id="oauth-modal-done" onclick="checkOAuthStatusFromModal()"
              class="w-full py-2.5 bg-emerald-600 hover:bg-emerald-500 text-white rounded-lg text-sm font-medium transition-colors">I've Authenticated</button>
            <p id="oauth-modal-msg" class="text-sm text-center text-slate-400"></p>
          </div>
        </div>
      </div>

      <!-- Provider grid -->
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 mb-6">
        <% for (var cp of catalogProviders) { %>
          <% if (cp.type === 'oauth') { %>
            <div class="border border-slate-700 rounded-xl p-4 hover:border-amber-500 transition-colors cursor-pointer"
                 id="oauth-card-<%= cp.id %>"
                 onclick="startOAuth('<%= agent.name %>', '<%= cp.id %>', event)">
              <div class="text-base font-medium text-white truncate mb-1"><%= cp.id %></div>
              <div class="text-xs text-slate-500 mb-3"><%= cp.modelCount || '?' %> models</div>
              <div class="text-center text-xs font-medium text-amber-400 bg-amber-900/20 rounded-lg py-2" id="oauth-label-<%= cp.id %>">OAuth Login</div>
            </div>
          <% } else { %>
            <div class="border border-slate-700 rounded-xl p-4 hover:border-slate-500 transition-colors cursor-pointer"
                 onclick="showKeyForm('<%= cp.id %>', event)">
              <div class="text-base font-medium text-white truncate mb-1"><%= cp.id %></div>
              <div class="text-xs text-slate-500 mb-3"><%= cp.modelCount %> model<%= cp.modelCount !== 1 ? 's' : '' %></div>
              <div id="key-form-<%= cp.id %>" class="hidden space-y-2" onclick="event.stopPropagation()">
                <input type="password" id="key-<%= cp.id %>"
                  class="w-full px-3 py-2 bg-slate-950 border border-slate-700 rounded-lg text-white text-sm font-mono focus:border-cyan-500 focus:outline-none"
                  placeholder="Paste API key"
                  onclick="event.stopPropagation()" onkeydown="event.stopPropagation()">
                <button onclick="event.stopPropagation(); addProvider('<%= cp.id %>')"
                  class="w-full py-2 bg-emerald-600 hover:bg-emerald-500 text-white text-sm rounded-lg transition-colors">Add</button>
                <span id="status-<%= cp.id %>" class="text-xs text-slate-500 block text-center"></span>
              </div>
              <div class="text-center text-sm text-cyan-400 font-medium bg-cyan-900/20 rounded-lg py-2" id="setup-hint-<%= cp.id %>">+ Setup</div>
            </div>
          <% } %>
        <% } %>
      </div>

      <!-- Custom provider -->
      <div class="border-t border-slate-700 pt-5">
        <p class="text-sm text-slate-500 mb-3">Or add a custom provider:</p>
        <div class="flex flex-wrap items-end gap-4">
          <div class="flex-1 min-w-[200px]">
            <label class="block text-xs text-slate-400 mb-1.5">Provider ID</label>
            <input type="text" id="custom-provider-id"
              class="w-full px-3 py-2.5 bg-slate-950 border border-slate-700 rounded-lg text-white text-sm font-mono focus:border-cyan-500 focus:outline-none"
              placeholder="e.g. anthropic">
          </div>
          <div class="flex-1 min-w-[200px]">
            <label class="block text-xs text-slate-400 mb-1.5">API Key</label>
            <input type="password" id="custom-provider-key"
              class="w-full px-3 py-2.5 bg-slate-950 border border-slate-700 rounded-lg text-white text-sm font-mono focus:border-cyan-500 focus:outline-none"
              placeholder="sk-...">
          </div>
          <button onclick="addCustomProvider()"
            class="px-5 py-2.5 bg-emerald-600 hover:bg-emerald-500 text-white rounded-lg text-sm font-medium transition-colors">Add</button>
          <span id="custom-status" class="text-xs text-slate-500 self-center"></span>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
function showKeyForm(id, event) {
  if (event) event.stopPropagation();
  var form = document.getElementById('key-form-' + id);
  if (form) form.classList.toggle('hidden');
}

function setStatus(id, msg, type) {
  var el = document.getElementById(id);
  if (!el) return;
  el.textContent = msg;
  el.className = 'text-xs block text-center ' + (type === 'error' ? 'text-red-400' : type === 'success' ? 'text-emerald-400' : 'text-slate-500');
}

async function addProvider(id) {
  var key = document.getElementById('key-' + id).value.trim();
  if (!key) { setStatus('status-' + id, 'Enter an API key', 'error'); return; }
  setStatus('status-' + id, 'Adding...', '');
  try {
    var r = await fetch('/api/providers/add', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ agent: '<%= agent.name %>', provider: id, api_key: key })
    });
    var data = await r.json();
    if (data.error) { setStatus('status-' + id, data.error, 'error'); return; }
    setStatus('status-' + id, 'Added! Reloading...', 'success');
    setTimeout(function() {
      var modelsTab = document.getElementById('tab-models');
      if (modelsTab) {
        var loader = modelsTab.querySelector('[hx-get]');
        if (loader) htmx.trigger(loader, 'load');
      } else {
        location.reload();
      }
    }, 1000);
  } catch (e) {
    setStatus('status-' + id, 'Failed: ' + e.message, 'error');
  }
}

async function addCustomProvider() {
  var id = document.getElementById('custom-provider-id').value.trim();
  var key = document.getElementById('custom-provider-key').value.trim();
  if (!id) { setStatus('custom-status', 'Enter a provider ID', 'error'); return; }
  if (!key) { setStatus('custom-status', 'Enter an API key', 'error'); return; }
  setStatus('custom-status', 'Adding...', '');
  try {
    var r = await fetch('/api/providers/add', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ agent: '<%= agent.name %>', provider: id, api_key: key })
    });
    var data = await r.json();
    if (data.error) { setStatus('custom-status', data.error, 'error'); return; }
    setStatus('custom-status', 'Added! Reloading...', 'success');
    setTimeout(function() {
      var modelsTab = document.getElementById('tab-models');
      if (modelsTab) {
        var loader = modelsTab.querySelector('[hx-get]');
        if (loader) htmx.trigger(loader, 'load');
      } else {
        location.reload();
      }
    }, 1000);
  } catch (e) {
    setStatus('custom-status', 'Failed: ' + e.message, 'error');
  }
}

// ── OAuth ─────────────────────────────────────────────────────

var oauthPollTimer = null;
var oauthAgent = '';
var oauthProvider = '';

function startOAuth(agent, provider, event) {
  if (event) event.stopPropagation();
  oauthAgent = agent;
  oauthProvider = provider;
  var label = document.getElementById('oauth-label-' + provider);
  label.textContent = 'Starting...';

  fetch('/agents/' + agent + '/models/oauth-login', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'x-csrf-token': '<%= csrf %>' },
    body: JSON.stringify({ provider: provider })
  })
  .then(function(r) { return r.json(); })
  .then(function(data) {
    if (data.error) {
      label.textContent = 'OAuth Login';
      alert('Failed: ' + data.error);
      return;
    }
    label.textContent = 'OAuth Login';
    document.getElementById('oauth-modal-title').textContent = provider + ' OAuth Login';
    document.getElementById('oauth-modal-url').textContent = data.url;
    document.getElementById('oauth-modal-url').href = data.url;
    document.getElementById('oauth-modal-code').textContent = data.code;
    document.getElementById('oauth-modal-msg').textContent = '';
    document.getElementById('oauth-modal').classList.remove('hidden');
    document.getElementById('oauth-modal').classList.add('flex');

    // Poll every 5s
    if (oauthPollTimer) clearInterval(oauthPollTimer);
    oauthPollTimer = setInterval(function() {
      checkOAuthStatus(true);
    }, 5000);
  })
  .catch(function(e) {
    label.textContent = 'OAuth Login';
    alert('Error: ' + e.message);
  });
}

function closeOAuthModal() {
  document.getElementById('oauth-modal').classList.remove('flex');
  document.getElementById('oauth-modal').classList.add('hidden');
  if (oauthPollTimer) { clearInterval(oauthPollTimer); oauthPollTimer = null; }
}

function copyOAuthCode() {
  var code = document.getElementById('oauth-modal-code').textContent;
  navigator.clipboard.writeText(code).catch(function() {});
}

function checkOAuthStatusFromModal() {
  checkOAuthStatus(false);
}

function checkOAuthStatus(isPoll) {
  if (!oauthAgent || !oauthProvider) return;
  fetch('/agents/' + oauthAgent + '/models/oauth-status?provider=' + encodeURIComponent(oauthProvider))
    .then(function(r) { return r.json(); })
    .then(function(data) {
      var msg = document.getElementById('oauth-modal-msg');
      if (data.status === 'complete') {
        if (oauthPollTimer) { clearInterval(oauthPollTimer); oauthPollTimer = null; }
        msg.textContent = 'Authentication complete!';
        msg.className = 'text-sm text-center text-emerald-400';
        setTimeout(function() {
          closeOAuthModal();
          var modelsTab = document.getElementById('tab-models');
          if (modelsTab) {
            var loader = modelsTab.querySelector('[hx-get]');
            if (loader) htmx.trigger(loader, 'load');
          } else {
            location.reload();
          }
        }, 1000);
      } else if (data.status === 'expired') {
        if (oauthPollTimer) { clearInterval(oauthPollTimer); oauthPollTimer = null; }
        msg.textContent = 'Session expired or cancelled. Try again.';
        msg.className = 'text-sm text-center text-red-400';
      } else {
        msg.textContent = isPoll ? 'Waiting... (check your browser)' : 'Not yet authenticated. Open the URL and enter the code.';
        msg.className = 'text-sm text-center text-slate-400';
      }
    })
    .catch(function(e) {
      var msg = document.getElementById('oauth-modal-msg');
      if (msg) { msg.textContent = 'Error: ' + e.message; msg.className = 'text-sm text-center text-red-400'; }
    });
}
</script>
<% } else { %>
<div class="border border-slate-800 rounded-xl p-6 text-center">
  <p class="text-sm text-slate-500">No configuration found for this agent.</p>
</div>
<% } %>