<div class="max-w-2xl mx-auto">
  <div class="mb-8">
    <a href="/agents" class="text-sm text-slate-500 hover:text-slate-300 transition-colors">&larr; Back to fleet</a>
    <h1 class="text-2xl font-bold text-white mt-3">Create Agent</h1>
    <p class="text-slate-400 text-sm mt-1">Set up a new AI agent runtime.</p>
  </div>

  <form method="POST" action="/agents/create" hx-post="/agents/create" hx-target="body" hx-swap="innerHTML" hx-headers='{"x-csrf-token": "<%= csrfToken %>"}' class="space-y-6">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <div>
      <label class="block text-sm font-medium text-slate-300 mb-2">Agent Name</label>
      <div class="flex items-stretch">
        <span class="px-3 bg-slate-950 border border-r-0 border-slate-700 rounded-l-lg text-sm text-slate-500 font-mono leading-[38px]"><%= prefix %>-</span>
        <select name="agent_type" id="agent-type"
          class="px-3 bg-slate-950 border border-l-0 border-r-0 border-slate-700 text-white text-sm font-mono focus:border-cyan-500 focus:outline-none focus:ring-1 focus:ring-cyan-500">
          <option value="openclaw">openclaw</option>
          <option value="picoclaw">picoclaw</option>
          <option value="hermes">hermes</option>
        </select>
        <span class="px-0.5 bg-slate-950 border border-l-0 border-r-0 border-slate-700 text-sm text-slate-500 font-mono leading-[38px]">-</span>
        <input type="text" name="agent_name" required pattern="[a-zA-Z0-9][a-zA-Z0-9_\-]*"
          class="flex-1 px-3 bg-slate-950 border border-l-0 border-slate-700 rounded-r-lg text-white text-sm focus:border-cyan-500 focus:outline-none focus:ring-1 focus:ring-cyan-500"
          placeholder="my-agent">
      </div>
      <p class="text-xs text-slate-500 mt-1">Letters, numbers, dashes, and underscores.</p>
    </div>

    <div>
      <label class="block text-sm font-medium text-slate-300 mb-2">Clone From (optional)</label>
      <select name="clone_source" id="clone-source" class="w-full px-3 py-2 bg-slate-950 border border-slate-700 rounded-lg text-white text-sm focus:border-cyan-500 focus:outline-none focus:ring-1 focus:ring-cyan-500">
        <option value="">Fresh install</option>
        <% for (const agent of agents) { %>
          <option value="<%= agent.name %>" data-agent-type="<%= agent.agent_type %>"><%= agent.name %></option>
        <% } %>
      </select>
      <p class="text-xs text-slate-500 mt-1">Only shows agents of the selected type.</p>
    </div>

    <div id="loading-area" class="hidden space-y-3">
      <div class="flex items-center justify-center gap-3 py-4">
        <svg class="animate-spin h-5 w-5 text-cyan-400" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none"/>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/>
        </svg>
        <span class="text-sm text-slate-300">Creating agent… this may take a couple of minutes.</span>
      </div>
    </div>

    <button type="submit" id="submit-btn" class="w-full px-4 py-2.5 bg-cyan-600 hover:bg-cyan-500 text-white rounded-lg text-sm font-medium transition-colors focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:ring-offset-2 focus:ring-offset-slate-900">
      Create <%= prefix %>-openclaw-…
    </button>
    <p id="onboard-note" class="text-xs text-slate-500 mt-2 text-center">Fresh agents run baseline setup automatically.</p>
  </form>
</div>

<script>
(function() {
  const basePrefix = '<%= prefix %>';
  const agentType = document.getElementById('agent-type');
  const agentName = document.querySelector('input[name="agent_name"]');
  const cloneSource = document.getElementById('clone-source');
  const submitBtn = document.getElementById('submit-btn');

  const onboardNote = document.getElementById('onboard-note');

  function updateForm() {
    const type = agentType.value;
    const name = (agentName.value || '…').replace(/[^a-zA-Z0-9_\-]/g, '').slice(0, 32) || '…';
    submitBtn.textContent = 'Create ' + basePrefix + '-' + type + '-' + name;

    const cloneOpts = cloneSource.querySelectorAll('option[data-agent-type]');
    for (const opt of cloneOpts) {
      opt.style.display = opt.dataset.agentType === type ? '' : 'none';
    }
    if (cloneSource.value && cloneSource.querySelector('option:checked[data-agent-type]')?.dataset.agentType !== type) {
      cloneSource.value = '';
    }

    onboardNote.textContent = cloneSource.value
      ? 'Cloned from ' + cloneSource.value + ' — config copied, no baseline needed.'
      : 'Fresh agent — baseline setup completes automatically.';
  }

  agentType.addEventListener('change', updateForm);
  agentName.addEventListener('input', updateForm);

  document.querySelector('form').addEventListener('submit', function() {
    submitBtn.disabled = true;
    submitBtn.classList.add('opacity-50', 'cursor-not-allowed');
    document.getElementById('loading-area').classList.remove('hidden');
  });

  updateForm();
})();
</script>
