<% if (activity.length > 0) { %>
<div class="overflow-x-auto rounded-xl border border-slate-800">
  <table class="w-full text-sm">
    <thead>
      <tr class="bg-slate-900/50 border-b border-slate-800">
        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-400 uppercase tracking-wider">Action</th>
        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-400 uppercase tracking-wider">Details</th>
        <th class="px-4 py-3 text-right text-xs font-semibold text-slate-400 uppercase tracking-wider">When</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-800/60">
      <% for (const event of activity) { 
        const isOk = event.status === 'ok';
        const actionColor = event.action === 'start' ? 'text-emerald-400' 
          : event.action === 'stop' ? 'text-amber-400' 
          : event.action === 'restart' ? 'text-cyan-400' 
          : 'text-slate-300';
        const actionBg = event.action === 'start' ? 'bg-emerald-400/10' 
          : event.action === 'stop' ? 'bg-amber-400/10' 
          : event.action === 'restart' ? 'bg-cyan-400/10' 
          : 'bg-slate-700/30';
        const actionIcon = event.action === 'start' ? '\u25B6' 
          : event.action === 'stop' ? '\u25A0' 
          : event.action === 'restart' ? '\u21BB' 
          : '\u2022';
      %>
        <tr class="hover:bg-slate-800/20 transition-colors group">
          <td class="px-4 py-3">
            <div class="flex items-center gap-2.5">
              <span class="inline-flex items-center justify-center w-7 h-7 rounded-lg text-xs <%= actionBg %> <%= actionColor %>"><%= actionIcon %></span>
              <div>
                <span class="font-medium text-white capitalize"><%= event.action %></span>
                <span class="ml-2 px-1.5 py-0.5 rounded text-[10px] font-medium uppercase tracking-wide <%= isOk ? 'bg-emerald-500/10 text-emerald-400' : 'bg-red-500/10 text-red-400' %>"><%= isOk ? 'ok' : 'err' %></span>
              </div>
            </div>
          </td>
          <td class="px-4 py-3 text-slate-400 text-xs"><%= event.details || '—' %></td>
          <td class="px-4 py-3 text-slate-500 text-xs text-right whitespace-nowrap"><%= new Date(event.timestamp).toLocaleString() %></td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>
<% } else { %>
<p class="text-slate-500 text-sm">No activity recorded yet.</p>
<% } %>
