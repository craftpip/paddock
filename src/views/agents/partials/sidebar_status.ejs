<% const sp = typeof poll !== 'undefined' && poll; %>
<div id="sidebar-status-block"
  <% if (sp) { %>
  hx-get="/agents/<%= agent.name %>/sidebar-status?expect=<%= poll %>"
  hx-trigger="every 2s"
  hx-swap="outerHTML"
  hx-target="this"
  <% } %>>
  <div class="flex items-center gap-3 mb-4">
    <div class="w-10 h-10 rounded-lg bg-slate-800 flex items-center justify-center text-lg font-bold text-cyan-400 border border-slate-700 flex-shrink-0">
      <%= agent.display_name.charAt(0) %>
    </div>
    <div class="min-w-0">
      <h1 class="text-base font-bold text-white truncate"><%= agent.display_name %></h1>
      <% if (sp) { %>
        <span class="px-2 py-0.5 rounded-full text-xs font-medium inline-block mt-0.5 bg-cyan-900/50 text-cyan-400 border border-cyan-800 flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
          <%= poll === 'running' ? 'starting' : 'stopping' %>
        </span>
      <% } else { %>
        <span class="px-2 py-0.5 rounded-full text-xs font-medium inline-block mt-0.5
          <%= agent.status === 'running' ? 'bg-emerald-900/50 text-emerald-400 border border-emerald-800' :
              agent.status === 'exited' ? 'bg-red-900/50 text-red-400 border border-red-800' :
              'bg-slate-800 text-slate-400 border border-slate-700' %>">
          <%= agent.status %>
        </span>
      <% } %>
    </div>
  </div>
  <div class="flex gap-2 mb-6">
    <% if (sp) { %>
      <span class="flex-1 px-2 py-1.5 bg-slate-800 text-slate-500 rounded-lg text-xs font-medium flex items-center justify-center gap-2">
        <svg class="w-3 h-3 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg>
        <%= poll === 'running' ? 'Starting' : 'Stopping' %>...
      </span>
    <% } else if (agent.status === 'running') { %>
      <button hx-post="/agents/<%= agent.name %>/stop"
              hx-target="#sidebar-status-block"
              hx-swap="outerHTML"
              hx-headers='{"x-csrf-token": "<%= csrfToken %>"}'
              hx-indicator="#sidebar-status-block"
              class="flex-1 px-2 py-1.5 bg-amber-600 hover:bg-amber-500 text-white rounded-lg text-xs font-medium transition-colors">Stop</button>
      <button hx-post="/agents/<%= agent.name %>/restart"
              hx-target="#sidebar-status-block"
              hx-swap="outerHTML"
              hx-headers='{"x-csrf-token": "<%= csrfToken %>"}'
              hx-indicator="#sidebar-status-block"
              class="flex-1 px-2 py-1.5 bg-slate-700 hover:bg-slate-600 text-white rounded-lg text-xs font-medium transition-colors">Restart</button>
    <% } else { %>
      <button hx-post="/agents/<%= agent.name %>/start"
              hx-target="#sidebar-status-block"
              hx-swap="outerHTML"
              hx-headers='{"x-csrf-token": "<%= csrfToken %>"}'
              hx-indicator="#sidebar-status-block"
              class="flex-1 px-2 py-1.5 bg-emerald-600 hover:bg-emerald-500 text-white rounded-lg text-xs font-medium transition-colors">Start</button>
    <% } %>
  </div>
<% if (sp) { %><script>(function(){var s=document.currentScript,p=s.parentNode;setTimeout(function(){p.removeAttribute('hx-get');p.removeAttribute('hx-trigger');},30000)})()</script><% } %>
</div>
