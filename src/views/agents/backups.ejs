<div class="mb-4 flex items-center justify-between">
  <h3 class="text-sm font-medium text-slate-300">Backups</h3>
  <form method="POST" action="/agents/<%= agent.name %>/backups/create" class="inline">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button class="px-3 py-1.5 bg-cyan-600 hover:bg-cyan-500 text-white rounded-lg text-sm transition-colors">Create Backup</button>
  </form>
</div>

<% if (backups.length > 0) { %>
<div class="border border-slate-800 rounded-xl overflow-hidden">
  <div class="overflow-x-auto">
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-slate-800 text-left text-slate-500">
          <th class="px-4 py-2 font-medium">File</th>
          <th class="px-4 py-2 font-medium w-24 hidden sm:table-cell">Size</th>
          <th class="px-4 py-2 font-medium w-40 hidden md:table-cell">Created</th>
          <th class="px-4 py-2 font-medium w-32">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% for (const b of backups) { %>
          <tr class="border-b border-slate-800/50 hover:bg-slate-800/30 group">
            <td class="px-4 py-2 text-slate-200 text-xs font-mono truncate max-w-[200px]"><%= b.name %></td>
            <td class="px-4 py-2 text-slate-500 text-xs hidden sm:table-cell"><%= fmtSize(b.size) %></td>
            <td class="px-4 py-2 text-slate-500 text-xs hidden md:table-cell"><%= new Date(b.created).toLocaleString() %></td>
            <td class="px-4 py-2">
              <div class="flex items-center gap-1 opacity-50 group-hover:opacity-100 transition-opacity">
                <a href="/agents/<%= agent.name %>/backups/download?file=<%= encodeURIComponent(b.name) %>" class="px-2 py-1 text-xs text-slate-400 hover:text-white hover:bg-slate-700 rounded transition-colors">Download</a>
                <button onclick="VMF.confirm({title:'Restore Backup',message:'Restore this backup? Current data will be overwritten.',danger:true,confirmText:'Restore'},function(){VMF.post('/agents/<%= agent.name %>/backups/restore',{_csrf:'<%= csrfToken %>'})})" class="px-2 py-1 text-xs text-amber-400 hover:text-amber-300 hover:bg-slate-700 rounded transition-colors">Restore</button>
                <button onclick="VMF.confirm({title:'Delete Backup',message:'Delete this backup permanently?',danger:true,confirmText:'Delete'},function(){VMF.post('/agents/<%= agent.name %>/backups/delete',{_csrf:'<%= csrfToken %>',file:'<%= b.name.replace(/'/g, "\\'") %>'})})" class="px-2 py-1 text-xs text-red-400 hover:text-red-300 hover:bg-slate-700 rounded transition-colors">Delete</button>
              </div>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
<% } else { %>
<div class="text-center py-12 text-slate-500">
  <svg class="w-8 h-8 mx-auto mb-2 text-slate-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"/></svg>
  <p class="text-sm">No backups yet. Create one to get started.</p>
</div>
<% } %>
